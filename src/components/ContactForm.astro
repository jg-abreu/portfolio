---
// Contact form, modeled on developer.org.tr: bare fields with only a bottom line, the field name as
// floating label and a round "Send →" button. Sending is off
// until the API is live (V2), and the status line says so; the e-mail is in the Connect list.
import { useTranslations, type Locale } from '../i18n/ui';
interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<form data-contact-form aria-labelledby="contact-heading" aria-describedby="contact-status">
	<label class="field">
		<input id="contact-name" name="name" autocomplete="name" required maxlength="100" placeholder=" " />
		<span class="field-label">{t('contact.name')}</span>
	</label>
	<label class="field">
		<input
			id="contact-email"
			name="email"
			type="email"
			autocomplete="email"
			required
			maxlength="254"
			placeholder=" "
		/>
		<span class="field-label">{t('contact.email')}</span>
	</label>
	<label class="field">
		<textarea id="contact-message" name="message" required minlength="10" maxlength="5000" rows="4" placeholder=" "
		></textarea>
		<span class="field-label">{t('contact.message')}</span>
	</label>
	<button type="submit" class="send" disabled aria-describedby="contact-status">
		{t('contact.send')}
		<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg>
	</button>
	<p id="contact-status" class="status" role="status">{t('contact.unavailable')}</p>
</form>

<script>
	// No endpoint yet: never navigate, transmit fields, or show a fabricated success.
	document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
		form.addEventListener('submit', (event) => event.preventDefault());
	});
</script>

<style>
	form {
		display: grid;
		gap: 0.75rem;
	}

	.field {
		position: relative;
		display: block;
	}

	.field-label {
		position: absolute;
		top: 1.25rem;
		left: 0;
		color: var(--fg-muted);
		line-height: 1.5;
		pointer-events: none;
		transform-origin: left top;
	}

	.field:focus-within .field-label,
	input:not(:placeholder-shown) + .field-label,
	textarea:not(:placeholder-shown) + .field-label {
		transform: translateY(-1.25rem) scale(0.75);
	}

	@media (prefers-reduced-motion: no-preference) {
		.field-label {
			transition: transform 0.2s ease;
		}
	}

	input,
	textarea {
		box-sizing: border-box;
		width: 100%;
		min-width: 0;
		padding: 1.25rem 0 0.75rem;
		background: transparent;
		border: 0;
		border-bottom: 1px solid var(--line);
		border-radius: 0;
		color: var(--fg);
		font: inherit;
		font-size: 1rem;
		line-height: 1.5;
	}

	textarea {
		min-height: 6.5rem;
		resize: vertical;
	}

	input:focus,
	textarea:focus {
		border-bottom-color: var(--fg);
		outline: none;
	}

	input:focus-visible,
	textarea:focus-visible {
		border-bottom-color: var(--brand);
		box-shadow: 0 1px 0 var(--brand);
	}

	.send {
		display: inline-flex;
		align-items: center;
		justify-self: start;
		gap: 0.5rem;
		margin-top: 1rem;
		padding: 0.7rem 1.4rem;
		background: var(--fg);
		border: 0;
		border-radius: 999px;
		color: var(--bg);
		font: inherit;
		font-size: 0.95rem;
		font-weight: 600;
		cursor: pointer;
	}

	.send svg {
		width: 1rem;
		height: 1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.send:disabled {
		cursor: not-allowed;
		opacity: 0.55;
	}

	.status {
		margin: 0.25rem 0 0;
		color: var(--fg-muted);
		font-size: 0.85rem;
		line-height: 1.6;
	}
</style>
