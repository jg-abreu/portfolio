---
import { useTranslations, type Locale } from '../i18n/ui';
import { limits } from '../lib/load-sim';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const limitText = t('lb.sim.limits').replace('{visitor}', String(limits.perVisitor)).replace('{instance}', String(limits.perInstance));
---
<section class="card lb" aria-labelledby="lb-heading" data-loadsim data-summary={t('lb.sim.summary')}
  data-instance={t('lb.instance')} data-start={t('lb.sim.start')} data-stop={t('lb.sim.stop')} data-reveal>
  <p class="kicker">{t('lb.kicker')}</p>
  <h2 id="lb-heading">{t('lb.title')}</h2>
  <p class="muted">{t('lb.body')}</p>

  <div class="lb-real">
    <p>{t('lb.yours')} <strong data-lb-instance>{t('journey.measuring')}</strong></p>
    <p class="muted small" data-lb-standby hidden>{t('lb.standby')}</p>
    <p class="muted small" data-lb-missing hidden>{t('journey.onlyLive')}</p>
  </div>

  <div class="lb-map" aria-hidden="true">
    <span class="node">Cloudflare</span><span class="arrow">→</span>
    <span class="node">nginx<small class="mono">hash(IP)</small></span><span class="arrow">→</span>
    <span class="pair"><span class="node api" data-lb-node="A">API A<small class="mono">:8080</small></span>
      <span class="node api" data-lb-node="B">API B<small class="mono">:8081</small></span></span><span class="arrow">→</span>
    <span class="node">PostgreSQL</span>
  </div>

  <h3>{t('lb.sim.title')}</h3>
  <p class="badge">{t('lb.sim.badge')}</p>
  <p class="muted small">{limitText}</p>

  <form class="lb-controls" data-lb-form>
    <fieldset>
      <legend>{t('lb.sim.route')}</legend>
      <label><input type="radio" name="route" value="assistant" checked /> {t('lb.sim.assistant')}</label>
      <label><input type="radio" name="route" value="page" /> {t('lb.sim.page')}</label>
    </fieldset>
    <label class="range">{t('lb.sim.you')} <output data-lb-out="you">5</output>
      <input type="range" name="you" min="0" max="20" step="1" value="5" /></label>
    <label class="range">{t('lb.sim.others')} <output data-lb-out="others">20</output>
      <input type="range" name="others" min="0" max="120" step="5" value="20" /></label>
    <label class="check"><input type="checkbox" name="downB" /> {t('lb.sim.down')}</label>
    <div class="buttons">
      <button class="btn btn-primary" type="button" data-lb-toggle>{t('lb.sim.start')}</button>
      <button class="btn" type="button" data-lb-reset>{t('lb.sim.reset')}</button>
    </div>
  </form>

  <div class="lb-stage" data-lb-stage>
    <div class="col"><div class="box source" data-lb-target="source">{t('lb.sim.sources')}</div></div>
    <div class="col"><div class="box" data-lb-target="cache">{t('lb.sim.cache')}<strong data-lb-count="cache">0</strong></div></div>
    <div class="col">
      <div class="box api" data-lb-target="A">API A<strong data-lb-count="A">0</strong></div>
      <div class="box api" data-lb-target="B">API B<small data-lb-offline hidden>{t('lb.sim.offline')}</small><strong data-lb-count="B">0</strong></div>
      <div class="box limited" data-lb-target="limited">{t('lb.sim.limited')}<strong data-lb-count="limited">0</strong></div>
    </div>
  </div>
  <p class="sr-only" role="status" data-lb-summary></p>
</section>

<script>
  import '../scripts/load-sim';
</script>

<style>
  .lb { margin: 0 0 4rem; padding: clamp(1.25rem, 3vw, 2rem); overflow-wrap: anywhere; }
  .lb h2 { margin: 0 0 .75rem; }
  .lb h3 { margin: 2rem 0 .5rem; font-size: 1.15rem; }
  .kicker { margin: 0 0 .5rem; color: var(--brand); font-size: .8rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .small { font-size: .85rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .mono { font-family: var(--font-mono); }
  .lb-real { margin: 1.25rem 0; padding: 1rem 1.25rem; border: 1px solid var(--line); border-radius: var(--radius); }
  .lb-real p { margin: 0; }
  .lb-real p + p { margin-top: .35rem; }
  .lb-real strong { color: var(--brand); }
  .lb-map { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; margin: 1rem 0; }
  .lb-map .pair { display: grid; gap: .4rem; }
  .lb-map .node { display: inline-grid; padding: .45rem .75rem; border: 1px solid var(--line); border-radius: .6rem; font-size: .9rem; font-weight: 600; }
  .lb-map .node small { color: var(--fg-muted); font-weight: 400; font-size: .75rem; }
  .lb-map .node.mine { border-color: var(--brand); box-shadow: 0 0 0 1px var(--brand); }
  .lb-map .arrow { color: var(--fg-muted); }
  .badge { display: inline-block; margin: 0 0 .5rem; padding: .25rem .65rem; border-radius: 999px; font-size: .8rem; font-weight: 600;
    background: color-mix(in srgb, var(--brand) 16%, transparent); color: var(--brand); }
  .lb-controls { display: grid; gap: .9rem; margin: 1rem 0 1.25rem; }
  .lb-controls fieldset { border: 0; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .4rem 1.25rem; }
  .lb-controls legend { width: 100%; margin-bottom: .35rem; font-weight: 600; font-size: .9rem; }
  .lb-controls label { display: flex; align-items: center; gap: .5rem; }
  .lb-controls .range { display: grid; grid-template-columns: 1fr auto; gap: .35rem .75rem; }
  .lb-controls .range input { grid-column: 1 / -1; width: 100%; accent-color: var(--accent); }
  .lb-controls output { font-family: var(--font-mono); font-weight: 700; }
  .lb-controls input[type=radio], .lb-controls input[type=checkbox] { accent-color: var(--accent); }
  .buttons { display: flex; gap: .75rem; flex-wrap: wrap; }
  .lb-stage { position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(.5rem, 3vw, 2.5rem);
    align-items: center; padding: 1rem; border: 1px dashed var(--line); border-radius: var(--radius); overflow: hidden; }
  .col { display: grid; gap: .6rem; }
  .box { display: grid; gap: .2rem; padding: .7rem .8rem; border: 1px solid var(--line); border-radius: .7rem; font-size: .85rem;
    background: var(--surface); text-align: center; }
  .box strong { font-family: var(--font-mono); font-size: 1.2rem; color: var(--fg); }
  .box.api strong { color: var(--brand); }
  .box.limited strong { color: #ef4444; }
  .box small { color: #ef4444; font-size: .75rem; }
  .box.off { opacity: .45; }
  .box.source { padding-block: 1.4rem; font-weight: 600; }
  .lb-stage :global(.dot) { position: absolute; top: 0; left: 0; width: 8px; height: 8px; margin: -4px 0 0 -4px; border-radius: 50%;
    background: var(--brand); pointer-events: none; opacity: 0; will-change: transform, opacity; }
  .lb-stage :global(.dot.cache) { background: #22c55e; }
  .lb-stage :global(.dot.limited) { background: #ef4444; }
  @media (max-width: 40rem) {
    .lb-stage { padding: .6rem; }
    .box { padding: .55rem .4rem; font-size: .75rem; }
    .box strong { font-size: 1rem; }
  }
</style>
