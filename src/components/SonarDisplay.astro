---
interface Props {
	index: number;
	total: number;
	label: string;
	detail: string;
	sectionWord: string;
}

const { index, total, label, detail, sectionWord } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="display" data-display>
	<div class="screen">
		<slot />
	</div>
	<div class="readout">
		<p class="head">
			<span>{sectionWord} {pad(index)} / {pad(total)}</span>
			<span>{label}</span>
		</p>
		<p class="detail">{detail}</p>
		<slot name="readout" />
	</div>
</div>

<style>
	.display {
		display: grid;
		gap: 0.75rem;
	}

	.screen,
	.readout {
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 0.75rem;
	}

	.screen {
		padding: 1.25rem;
	}

	.readout {
		display: grid;
		gap: 0.5rem;
		padding: 0.9rem 1rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.1em;
	}

	.readout p {
		margin: 0;
	}

	.head {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		color: var(--fg-muted);
	}

	.detail {
		color: var(--accent);
	}
</style>
