---
// Technology tiles with each brand's logo (simple-icons, CC0), rendered at build time: no JavaScript,
// no requests. Names without a logo in simple-icons get their initial instead of an invented mark.
import {
	siApachemaven,
	siDocker,
	siFlyway,
	siGit,
	siGithubactions,
	siHibernate,
	siJavascript,
	siJunit5,
	siMysql,
	siNginx,
	siOpenjdk,
	siPostgresql,
	siPython,
	siReact,
	siSpring,
	siSpringboot,
	siTypescript,
	type SimpleIcon,
} from 'simple-icons';

interface Props {
	items: string[];
}

const logos: Record<string, SimpleIcon> = {
	Java: siOpenjdk,
	'Spring Boot': siSpringboot,
	'Spring Data JPA': siSpring,
	Hibernate: siHibernate,
	PostgreSQL: siPostgresql,
	MySQL: siMysql,
	Flyway: siFlyway,
	'JUnit 5': siJunit5,
	Docker: siDocker,
	'GitHub Actions': siGithubactions,
	Maven: siApachemaven,
	Git: siGit,
	nginx: siNginx,
	React: siReact,
	TypeScript: siTypescript,
	JavaScript: siJavascript,
	Python: siPython,
};

// Brand colors too dark to read on the dark theme fall back to the text color.
function brandColor(hex: string): string | null {
	const [r, g, b] = [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
	return 0.2126 * r + 0.7152 * g + 0.0722 * b < 0.25 ? null : `#${hex}`;
}

const tiles = Astro.props.items.map((name) => {
	const icon = logos[name];
	return { name, path: icon?.path ?? null, color: icon ? brandColor(icon.hex) : null };
});
---

<ul class="tech">
	{
		tiles.map((tile) => (
			<li style={tile.color ? `--brand: ${tile.color}` : undefined}>
				<span class="logo" aria-hidden="true">
					{tile.path ? (
						<svg viewBox="0 0 24 24">
							<path d={tile.path} />
						</svg>
					) : (
						tile.name.charAt(0)
					)}
				</span>
				<span class="name">{tile.name}</span>
			</li>
		))
	}
</ul>

<style>
	.tech {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li {
		display: grid;
		justify-items: center;
		gap: 0.6rem;
		padding: 1.1rem 0.75rem;
		background: color-mix(in srgb, var(--surface) 92%, transparent);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		text-align: center;
	}

	.logo {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		background: color-mix(in srgb, var(--brand, var(--fg)) 12%, transparent);
		border-radius: 0.6rem;
		color: var(--brand, var(--fg));
		font-weight: 700;
	}

	svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: currentColor;
	}

	.name {
		font-size: 0.85rem;
		font-weight: 500;
		line-height: 1.3;
	}

	@media (prefers-reduced-motion: no-preference) {
		li {
			transition:
				transform 0.25s var(--ease),
				border-color 0.2s;
		}

		li:hover {
			border-color: var(--fg-muted);
			transform: translateY(-2px);
		}
	}
</style>
