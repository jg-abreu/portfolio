---
import type { HeatCell } from '../lib/activity';

interface Props {
	cells: HeatCell[];
	today: string;
	localeTag: string;
	/** Tooltip templates with {n} and {date}. */
	labelOne: string;
	labelMany: string;
	summary: string;
}

const { cells, today, localeTag, labelOne, labelMany, summary } = Astro.props;

// GitHub-style grid: rounded squares with small gaps, months on top, Mon/Wed/Fri on the left.
const STEP = 13;
const SIZE = 10.5;
const TOP = 18;
const LEFT = 30;
const weeks = Math.max(...cells.map((c) => c.week)) + 1;
const monthFormat = new Intl.DateTimeFormat(localeTag, { month: 'short', timeZone: 'UTC' });
const weekdayFormat = new Intl.DateTimeFormat(localeTag, { weekday: 'short', timeZone: 'UTC' });
const toDate = (d: string) => new Date(`${d}T00:00:00Z`);
const clean = (s: string) => s.replace('.', '').replace(/^./, (c) => c.toUpperCase());

// A month label above the first week whose Sunday falls in that month's first seven days.
const months = cells
	.filter((c) => c.weekday === 0 && toDate(c.date).getUTCDate() <= 7 && c.week > 0)
	.map((c) => ({ x: LEFT + c.week * STEP, label: clean(monthFormat.format(toDate(c.date))) }));

// Rows are Sunday (0) to Saturday (6); 2024-01-01 was a Monday, so day 1 + n is weekday n.
const weekdays = [1, 3, 5].map((n) => ({
	y: TOP + n * STEP + SIZE - 1.5,
	label: clean(weekdayFormat.format(toDate(`2024-01-0${n}`))),
}));

// One shared tooltip (github-live.ts) instead of a <title> per day keeps the page ~370 nodes lighter.
---

<figure class="heatmap" data-heatmap data-label-one={labelOne} data-label-many={labelMany}>
	<div class="plot">
		<p class="tip" data-heat-tip hidden></p>
		<svg viewBox={`0 0 ${LEFT + weeks * STEP} ${TOP + 7 * STEP}`} role="img" aria-label={summary}>
			{
				months.map((m) => (
					<text class="label" x={m.x} y="11">
						{m.label}
					</text>
				))
			}
			{
				weekdays.map((d) => (
					<text class="label" x="0" y={d.y}>
						{d.label}
					</text>
				))
			}
			{
				cells.map((c) => (
					<rect
						class:list={[`l${c.level}`, { today: c.date === today }]}
						x={LEFT + c.week * STEP}
						y={TOP + c.weekday * STEP}
						width={SIZE}
						height={SIZE}
						rx="2.5"
						data-date={c.date}
						data-count={c.count}
					/>
				))
			}
		</svg>
	</div>
</figure>

<style>
	.heatmap {
		margin: 0;
	}

	.plot {
		position: relative;
	}

	.tip {
		position: absolute;
		z-index: 1;
		margin: 0;
		padding: 0.3rem 0.5rem;
		background: var(--bg);
		border: 1px solid var(--line);
		border-radius: 0.35rem;
		color: var(--fg);
		font-family: var(--font-sans);
		font-size: 0.7rem;
		white-space: nowrap;
		pointer-events: none;
		transform: translate(-50%, calc(-100% - 6px));
	}

	/* The whole year always fits the card: the drawing scales with its width, no sideways scroll. */
	svg {
		display: block;
		width: 100%;
		height: auto;
	}

	.label {
		fill: var(--fg-muted);
		font-family: var(--font-sans);
		font-size: 9px;
	}

	/* Empty days are solid, slightly lighter than the card; active days go from dim to bright green. */
	.l0 {
		fill: color-mix(in srgb, var(--fg) 7%, var(--surface));
	}

	.l1 {
		fill: color-mix(in srgb, var(--heat) 35%, var(--surface));
	}

	.l2 {
		fill: color-mix(in srgb, var(--heat) 60%, var(--surface));
	}

	.l3 {
		fill: color-mix(in srgb, var(--heat) 82%, var(--surface));
	}

	.l4 {
		fill: var(--heat);
	}
</style>
