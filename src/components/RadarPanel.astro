---
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
	locale: Locale;
}

const t = useTranslations(Astro.props.locale);

// Static radar scope; stage 6 turns it into the animated island.
const rings = [60, 120, 180];
const ticks = Array.from({ length: 36 }, (_, i) => i * 10);
---

<div class="panel" aria-hidden="true">
	<svg class="scope" viewBox="0 0 400 400">
		<defs>
			<radialGradient id="sweep-fade" cx="200" cy="200" r="180" gradientUnits="userSpaceOnUse">
				<stop offset="0" stop-color="var(--accent)" stop-opacity="0.35" />
				<stop offset="1" stop-color="var(--accent)" stop-opacity="0.05" />
			</radialGradient>
		</defs>
		{rings.map((r) => <circle class="ring" cx="200" cy="200" r={r} />)}
		<line class="axis" x1="20" y1="200" x2="380" y2="200" />
		<line class="axis" x1="200" y1="20" x2="200" y2="380" />
		{
			ticks.map((deg) => (
				<line
					class="tick"
					x1="200"
					y1={deg % 90 === 0 ? 8 : 14}
					x2="200"
					y2="20"
					transform={`rotate(${deg} 200 200)`}
				/>
			))
		}
		<path class="sweep" d="M200 200 L200 20 A180 180 0 0 1 355.9 110 Z" fill="url(#sweep-fade)" />
		<line class="beam" x1="200" y1="200" x2="355.9" y2="110" />
		<circle class="origin" cx="200" cy="200" r="4" />
	</svg>
	<p class="caption">
		<span>{t('panel.status')}</span>
		<span>{t('panel.position')}</span>
	</p>
</div>

<style>
	.panel {
		display: grid;
		place-items: center;
		align-content: center;
		gap: 1.25rem;
		height: 100%;
		padding: 1.5rem;
	}

	.scope {
		width: min(100%, 26rem);
		height: auto;
	}

	.ring {
		fill: none;
		stroke: var(--line);
		stroke-width: 1.5;
		stroke-dasharray: 4 6;
	}

	.axis,
	.tick {
		stroke: var(--line);
		stroke-width: 1;
	}

	.beam {
		stroke: var(--accent);
		stroke-width: 2;
	}

	.origin {
		fill: var(--accent);
	}

	.caption {
		display: grid;
		gap: 0.25rem;
		margin: 0;
		color: var(--fg-muted);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.15em;
		text-align: center;
	}

	@media (max-width: 59.99rem) {
		.panel {
			grid-template-columns: auto auto;
			padding: 1rem;
		}

		.scope {
			width: 6rem;
		}

		.caption {
			text-align: left;
		}
	}
</style>
