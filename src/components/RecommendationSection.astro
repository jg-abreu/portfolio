---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Locale } from '../i18n/ui';
import { recommendationUi } from '../i18n/recommendations';
import { bookGroups, isAmazon, starFill, type PublicSection } from '../lib/recommendations';
import { bookCoverUrl } from '../lib/google-books';

interface Props { section: PublicSection; locale: Locale }
const { section, locale } = Astro.props;
const labels = recommendationUi[locale];
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/recommendations-generated/*.png', { eager: true });
function imageFor(key: string) {
  const image = images[`../assets/recommendations-generated/${key}`]?.default;
  if (!image) throw new Error(`Missing recommendation image: ${key}`);
  return image;
}
const books = section.kind === 'BOOKS';
const groups = books
  ? bookGroups.map(group => ({ id: group, title: labels.groups[group], items: section.items.filter(item => item.data.bookGroup === group) }))
    .filter(group => group.items.length > 0)
  : [{ id: 'all', title: '', items: section.items }];
const usesGoogle = section.items.some(item => item.data.googleBooksId);
const ratingLabel = (rating: number) => labels.rating.replace('{n}', rating.toLocaleString(locale === 'pt' ? 'pt-BR' : 'en-US'));
const buttonLabel = (url: string) => (isAmazon(url) ? labels.buyAmazon : books ? labels.openBook : labels.openItem);
---
<div class:list={['rec-groups', { split: groups.length > 1 }]}>
  {groups.map(group => <div class="rec-group">
    {group.title && <h2>{group.title}</h2>}
    <ul class="rec-grid">
      {group.items.map(({ data }) => <li class="rec-card" data-reveal>
        <div class:list={['rec-media', { book: books }]}>
          {data.googleBooksId ? <img src={bookCoverUrl(data.googleBooksId)} alt={data[locale].imageAlt} width="184" height="276"
            loading="lazy" decoding="async" referrerpolicy="no-referrer" />
            : data.imageKey ? <Image src={imageFor(data.imageKey)} alt={data[locale].imageAlt} widths={[240, 480]}
              sizes="240px" width={480} loading="lazy" decoding="async" />
            : <svg class="rec-placeholder" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v10H4Zm4 14h8m-4-4v4" /></svg>}
        </div>
        <h3>{data[locale].title}</h3>
        {books && <span class="rec-stars" role="img" aria-label={ratingLabel(data.rating)}>
          {[1, 2, 3, 4, 5].map(star => <span class:list={['star', starFill(data.rating, star)]} aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="m12 2.8 2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.6l-5.8 3.1 1.1-6.5-4.7-4.6 6.5-.9Z" /></svg>
            <svg class="fill" viewBox="0 0 24 24"><path d="m12 2.8 2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.6l-5.8 3.1 1.1-6.5-4.7-4.6 6.5-.9Z" /></svg>
          </span>)}
        </span>}
        {data.subtitle && <p class="rec-subtitle">{data.subtitle}</p>}
        {data.readIn && <span class="rec-badge">{labels.readIn[data.readIn]}</span>}
        <p class="rec-description">{data[locale].description}</p>
        {data.url && <a class="rec-link" href={data.url} target="_blank" rel="noopener noreferrer">
          <span>{buttonLabel(data.url)}<span class="sr-only">: {data[locale].title}</span></span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6m0-6-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" /></svg>
        </a>}
      </li>)}
    </ul>
  </div>)}
</div>
{usesGoogle && <p class="rec-attribution">{labels.bookSource}
  <img src="https://books.google.com/googlebooks/images/poweredby.png" alt={labels.poweredBy} width="62" height="30" loading="lazy" referrerpolicy="no-referrer" /></p>}

<style>
  .rec-groups { display: grid; gap: 2.5rem; }
  .rec-group h2 { font-size: clamp(1.4rem, 2.6vw, 1.9rem); margin: 0 0 1.25rem; }
  .rec-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 13.5rem), 1fr)); gap: 2.25rem 1.75rem; list-style: none; margin: 0; padding: 0; }
  .rec-card { display: flex; flex-direction: column; gap: .5rem; min-width: 0; overflow-wrap: anywhere; }
  .rec-media { display: grid; place-items: center; height: 14rem; margin-bottom: .6rem; }
  .rec-media > :is(img, picture) { display: block; height: 100%; width: auto; max-width: 100%; min-height: 0; object-fit: contain;
    border-radius: .6rem; box-shadow: 0 10px 30px #0003; }
  .rec-media:not(.book) { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); padding: .75rem; }
  .rec-media:not(.book) > :is(img, picture) { box-shadow: none; }
  .rec-placeholder { width: 3rem; height: 3rem; fill: none; stroke: var(--fg-muted); stroke-width: 1.5; }
  .rec-card h3 { margin: 0; font-size: 1.1rem; }
  .rec-stars { display: inline-flex; gap: .15rem; }
  .star { position: relative; display: inline-block; width: 1.15rem; height: 1.15rem; }
  .star svg { position: absolute; inset: 0; width: 100%; height: 100%; fill: var(--line); }
  .star .fill { fill: #facc15; clip-path: inset(0 100% 0 0); }
  .star.full .fill { clip-path: none; }
  .star.half .fill { clip-path: inset(0 50% 0 0); }
  .rec-subtitle { margin: 0; color: var(--fg-muted); font-size: .95rem; }
  .rec-badge { align-self: flex-start; padding: .15rem .55rem; border: 1px solid var(--line); border-radius: 999px; color: var(--fg-muted); font-size: .75rem; }
  .rec-description { margin: 0; color: var(--fg-muted); line-height: 1.65; white-space: pre-line; }
  .rec-link { display: flex; align-items: center; justify-content: center; gap: .6rem; width: 100%; margin-top: auto; padding: .8rem 1rem;
    border-radius: .65rem; background: var(--fg); color: var(--bg); font-weight: 600; text-decoration: none; transition: opacity .2s; }
  .rec-description + .rec-link, .rec-badge + .rec-link { margin-top: .75rem; }
  .rec-link:hover { opacity: .85; }
  .rec-link:focus-visible { outline: 2px solid var(--brand); outline-offset: 3px; }
  .rec-link svg { width: 1.05rem; height: 1.05rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .rec-attribution { display: flex; align-items: center; gap: .6rem; margin-top: 2rem; color: var(--fg-muted); font-size: .85rem; }
  .rec-attribution img { width: 62px; height: 30px; object-fit: contain; }
  @media (min-width: 64rem) {
    .rec-groups.split { grid-template-columns: 1fr 1fr; gap: 3rem; }
    .rec-groups.split .rec-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (prefers-reduced-motion: reduce) { .rec-link { transition: none; } }
</style>
