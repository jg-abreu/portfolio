---
import ContactIcon from './ContactIcon.astro';
import { getContacts, getResumePath } from '../lib/content';
import { useTranslations, type Locale } from '../i18n/ui';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const contacts = (await getContacts()).filter(c => c.kind !== 'email');
const resumePath = getResumePath(locale);
---

<nav class="hero-contacts" aria-label={t('nav.contact')}>
	<ul>
		{contacts.map(c => (
			<li>
				<a class="icon-link" href={c.url} aria-label={c.label} title={c.label}>
					<ContactIcon name={c.kind} />
				</a>
			</li>
		))}
		{resumePath && <li><a class="icon-link" href={resumePath} aria-label={t('contact.resume')} title={t('contact.resume')}><ContactIcon name="resume" /></a></li>}
	</ul>
</nav>

<style>
	.hero-contacts { margin-block: 1rem 1.5rem; scroll-margin-top: 7rem; }
	ul { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0; padding: 0; list-style: none; }
	li { position: relative; }
	:global(.hero-contacts .icon-link) {
		display: inline-flex; align-items: center; justify-content: center;
		width: 2.75rem; height: 2.75rem; border: 1px solid var(--line);
		border-radius: 50%; color: var(--fg-muted); background: var(--surface); text-decoration: none;
	}
	:global(.hero-contacts .icon-link:hover), :global(.hero-contacts .icon-link:focus-visible) { color: var(--accent); border-color: var(--accent); }
	@media (prefers-reduced-motion: no-preference) {
		:global(.hero-contacts .icon-link) { transition: transform 180ms ease, opacity 180ms ease; }
		:global(.hero-contacts .icon-link:hover) { transform: translateY(-2px); }
	}
</style>
