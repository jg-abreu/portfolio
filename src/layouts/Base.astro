---
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoLatin from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
import RadarPanel from '../components/RadarPanel.astro';
import {
	defaultLocale,
	isLocale,
	localeNames,
	localeTags,
	locales,
	useTranslations,
	type Locale,
} from '../i18n/ui';

interface Props {
	title?: string;
	description?: string;
}

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const t = useTranslations(locale);
const { title = t('site.title'), description = t('site.description') } = Astro.props;

// Path after the locale segment, so the language switch keeps the same page.
const pathInLocale = Astro.url.pathname.replace(/^\/(en|pt)(\/|$)/, '');
const canonical = getAbsoluteLocaleUrl(locale, pathInLocale);

// Section anchors point at the home page so they also work from other pages.
const home = getRelativeLocaleUrl(locale);
const sections = [
	{ id: 'projects', label: t('nav.projects') },
	{ id: 'signals', label: t('nav.signals') },
	{ id: 'contact', label: t('nav.contact') },
];

// Self-hosted fonts, Latin subset only (covers Portuguese accents).
const latinRange =
	'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fontFaces = `
@font-face{font-family:'Inter Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${interLatin}) format('woff2-variations');unicode-range:${latinRange}}
@font-face{font-family:'JetBrains Mono';font-style:normal;font-display:swap;font-weight:400;src:url(${monoLatin}) format('woff2');unicode-range:${latinRange}}
`;
---

<!doctype html>
<html lang={localeTags[locale]}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#070D1C" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
		<style is:inline set:html={fontFaces} />

		<link rel="canonical" href={canonical} />
		{locales.map((l) => <link rel="alternate" hreflang={localeTags[l]} href={getAbsoluteLocaleUrl(l, pathInLocale)} />)}
		<link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl(defaultLocale, pathInLocale)} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={localeTags[locale].replace('-', '_')} />
		{
			locales
				.filter((l) => l !== locale)
				.map((l) => <meta property="og:locale:alternate" content={localeTags[l].replace('-', '_')} />)
		}
	</head>
	<body>
		<a class="skip-link" href="#main">{t('nav.skip')}</a>
		<div class="shell">
			<aside class="side">
				<RadarPanel locale={locale} />
			</aside>
			<div class="content">
				<header class="site-header">
					<a class="brand" href={home}>JA<span>/</span></a>
					<nav class="sections" aria-label={t('nav.sections')}>
						<ul>
							{
								sections.map((s) => (
									<li>
										<a href={`${home}#${s.id}`}>{s.label}</a>
									</li>
								))
							}
						</ul>
					</nav>
					<nav class="languages" aria-label={t('nav.language')}>
						<ul>
							{
								locales.map((l) => (
									<li>
										<a
											href={getRelativeLocaleUrl(l, pathInLocale)}
											hreflang={localeTags[l]}
											lang={localeTags[l]}
											aria-current={l === locale ? 'page' : undefined}
										>
											{l.toUpperCase()}
											<span class="visually-hidden">{localeNames[l]}</span>
										</a>
									</li>
								))
							}
						</ul>
					</nav>
				</header>
				<slot />
			</div>
		</div>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: dark;
		/* Sonar palette: navy background, lightened BIC blue as the accent. */
		--bg: #070d1c;
		--surface: #0b1428;
		--line: #1f3d99; /* BIC blue: borders and rings only, never text */
		--fg: #e3e8f7;
		--fg-muted: #8f9ab8;
		--accent: #6f8cff;
		--font-sans: 'Inter Variable', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
		--font-mono: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
		--header-height: 3.5rem;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		/* Room for the sticky header, which wraps to two lines on narrow phones. */
		scroll-padding-top: 6.5rem;
	}

	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}
	}

	body {
		margin: 0;
		min-height: 100vh;
		background: var(--bg);
		color: var(--fg);
		font-family: var(--font-sans);
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
	}

	a {
		color: var(--accent);
		text-underline-offset: 0.2em;
	}

	:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	::selection {
		background: var(--line);
		color: var(--fg);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
</style>

<style>
	.skip-link {
		position: absolute;
		top: 0.5rem;
		left: 0.5rem;
		z-index: 10;
		padding: 0.5rem 0.75rem;
		background: var(--accent);
		color: var(--bg);
		font-weight: 600;
		transform: translateY(-200%);
	}

	.skip-link:focus {
		transform: none;
	}

	.side {
		border-bottom: 1px solid var(--line);
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 5;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1.5rem;
		min-height: var(--header-height);
		padding: 0.5rem 1rem;
		background: var(--bg);
		border-bottom: 1px solid var(--line);
		font-family: var(--font-mono);
		font-size: 0.8rem;
	}

	.brand {
		color: var(--fg);
		font-weight: 400;
		letter-spacing: 0.1em;
		text-decoration: none;
	}

	.brand span {
		color: var(--accent);
	}

	.site-header ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.sections {
		flex: 1;
	}

	.sections a {
		color: var(--fg-muted);
		text-decoration: none;
	}

	.sections a:hover {
		color: var(--fg);
	}

	.languages a {
		color: var(--fg-muted);
		text-decoration: none;
	}

	.languages a[aria-current='page'] {
		color: var(--accent);
	}

	@media (min-width: 60rem) {
		.shell {
			display: grid;
			grid-template-columns: minmax(20rem, 2fr) 3fr;
		}

		.side {
			position: sticky;
			top: 0;
			height: 100vh;
			border-right: 1px solid var(--line);
			border-bottom: 0;
		}

		.site-header {
			padding-inline: 2rem;
		}
	}
</style>
