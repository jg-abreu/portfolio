---
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n';
import { createHash } from 'node:crypto';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoLatin from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
import {
	defaultLocale,
	isLocale,
	localeNames,
	localeTags,
	locales,
	useTranslations,
	type Locale,
} from '../i18n/ui';

interface Props {
	title?: string;
	description?: string;
	/** Pages outside the locale tree (the 404): no canonical/hreflang, not indexed, language links go home. */
	standalone?: boolean;
	/** Locale for standalone pages, which Astro cannot infer from the URL. */
	locale?: Locale;
}

const { standalone = false } = Astro.props;
const locale: Locale = Astro.props.locale ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale);
const t = useTranslations(locale);
const { title = t('site.title'), description = t('site.description') } = Astro.props;

// Path after the locale segment, so the language switch keeps the same page.
const pathInLocale = standalone ? '' : Astro.url.pathname.replace(/^\/(en|pt)(\/|$)/, '');
const canonical = getAbsoluteLocaleUrl(locale, pathInLocale);
// One share image per locale (generated by `npm run og`).
const ogImage = new URL(`/og/og-${locale}.png`, Astro.site).href;

// Section anchors point at the home page so they also work from other pages.
const home = getRelativeLocaleUrl(locale);
const sections = [
	{ id: 'projects', label: t('nav.projects') },
	{ id: 'about', label: t('nav.about') },
	{ id: 'stack', label: t('nav.stack') },
	{ id: 'activity', label: t('nav.activity') },
	{ id: 'signals', label: t('nav.signals') },
	{ id: 'pipeline', label: t('nav.pipeline') },
	{ id: 'contact', label: t('nav.contact') },
];

// Self-hosted fonts, Latin subset only (covers Portuguese accents).
const latinRange =
	'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fontFaces = `
@font-face{font-family:'Inter Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${interLatin}) format('woff2-variations');unicode-range:${latinRange}}
@font-face{font-family:'JetBrains Mono';font-style:normal;font-display:swap;font-weight:400;src:url(${monoLatin}) format('woff2');unicode-range:${latinRange}}
`;
// Runs before the first paint so the page never flashes the wrong theme: stored choice, else the system.
const themeBootstrap = `(function(){var d=document.documentElement,t=null;try{t=localStorage.getItem('theme')}catch(e){}if(t!=='light'&&t!=='dark')t=matchMedia('(prefers-color-scheme: light)').matches?'light':'dark';d.setAttribute('data-theme',t);var m=document.querySelector('meta[name="theme-color"]');if(m)m.setAttribute('content',t==='light'?'#FFFFFF':'#020617')})();`;
// Hash the exact inline payloads; changing any of them automatically changes its CSP allowance.
const revealBootstrap = `(function(){var d=document.documentElement;if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;d.classList.add('fx');setTimeout(function(){if(!d.hasAttribute('data-fx-ready'))d.classList.remove('fx')},2500)})();`;
Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(themeBootstrap).digest('base64')}`);
Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(revealBootstrap).digest('base64')}`);
Astro.csp?.insertStyleHash(`sha256-${createHash('sha256').update(fontFaces).digest('base64')}`);
---

<!doctype html>
<html lang={localeTags[locale]}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#020617" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
		<style is:inline set:html={fontFaces} />
		<script is:inline set:html={themeBootstrap} />
		<script is:inline set:html={revealBootstrap} />

		{
			standalone ? (
				<meta name="robots" content="noindex" />
			) : (
				<>
					<link rel="canonical" href={canonical} />
					{locales.map((l) => (
						<link rel="alternate" hreflang={localeTags[l]} href={getAbsoluteLocaleUrl(l, pathInLocale)} />
					))}
					<link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl(defaultLocale, pathInLocale)} />
				</>
			)
		}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="João Abreu" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={t('og.alt')} />
		<meta property="og:locale" content={localeTags[locale].replace('-', '_')} />
		{
			locales
				.filter((l) => l !== locale)
				.map((l) => <meta property="og:locale:alternate" content={localeTags[l].replace('-', '_')} />)
		}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={ogImage} />
		<slot name="head" />
	</head>
	<body>
		<div class="progress" aria-hidden="true"></div>
		<a class="skip-link" href="#main">{t('nav.skip')}</a>
		<header class="site-header">
			<div class="header-inner">
				<a class="brand" href={home} aria-label="João Abreu">JA</a>
				<nav class="sections" aria-label={t('nav.sections')}>
					<ul>
						{
							sections.map((s) => (
								<li>
									<a href={`${home}#${s.id}`}>{s.label}</a>
								</li>
							))
						}
					</ul>
				</nav>
				<div class="tools">
					<nav class="languages" aria-label={t('nav.language')}>
						<ul>
							{
								locales.map((l) => (
									<li>
										<a
											href={getRelativeLocaleUrl(l, pathInLocale)}
											hreflang={localeTags[l]}
											lang={localeTags[l]}
											aria-current={l === locale ? 'page' : undefined}
										>
											{l.toUpperCase()}
											<span class="visually-hidden">{localeNames[l]}</span>
										</a>
									</li>
								))
							}
						</ul>
					</nav>
					<!-- Shown by scripts/theme.ts; without JavaScript the page simply follows the system theme. -->
					<button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" title={t('nav.theme')} hidden>
						<svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
							<circle cx="12" cy="12" r="4"></circle>
							<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
						</svg>
						<svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
						</svg>
						<span class="visually-hidden">{t('nav.theme')}</span>
					</button>
				</div>
			</div>
		</header>
		<slot />
		<script>
			import '../scripts/theme';
			import '../scripts/scroll-fx';
		</script>
	</body>
</html>

<style is:global>
	/*
	 * v3 palettes. Dark: deep navy with a wine-to-violet glow at the top (in the spirit of developer.org.tr).
	 * Light: plain white, near-black ink and hairline borders (in the spirit of augustogalego.com).
	 * Kept in two places on purpose: [data-theme] is set by the head script, the media query covers
	 * visitors without JavaScript. Change both together (and the bar colors in scripts/theme.ts).
	 */
	:root {
		color-scheme: dark;
		--bg: #020617;
		--surface: #0b1224;
		--surface-2: #111a2e;
		--line: #1e293b;
		--fg: #fafafa;
		--fg-muted: #a1a1aa;
		--accent: #fafafa;
		--on-accent: #020617;
		--heat: #4ade80;
		--glow: radial-gradient(60% 75% at 12% 0%, rgb(127 29 61 / 0.6), transparent 70%),
			radial-gradient(55% 70% at 88% 0%, rgb(91 33 182 / 0.5), transparent 70%);
		--font-sans: 'Inter Variable', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
		--font-mono: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
		--header-height: 4rem;
		--page-width: 68rem;
		--gutter: clamp(1rem, 4vw, 2.5rem);
		--radius: 1rem;
		--ease: cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	:root[data-theme='light'] {
		color-scheme: light;
		--bg: #ffffff;
		--surface: #ffffff;
		--surface-2: #f5f5f5;
		--line: #e5e5e5;
		--fg: #171717;
		--fg-muted: #5c5c5c;
		--accent: #171717;
		--on-accent: #ffffff;
		--heat: #171717;
		--glow: none;
	}

	@media (prefers-color-scheme: light) {
		:root:not([data-theme]) {
			color-scheme: light;
			--bg: #ffffff;
			--surface: #ffffff;
			--surface-2: #f5f5f5;
			--line: #e5e5e5;
			--fg: #171717;
			--fg-muted: #5c5c5c;
			--accent: #171717;
			--on-accent: #ffffff;
			--heat: #171717;
			--glow: none;
		}
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		/* Room for the sticky header, which wraps to two lines on narrow phones. */
		scroll-padding-top: 7.5rem;
	}

	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}
	}

	body {
		position: relative;
		isolation: isolate;
		margin: 0;
		min-height: 100vh;
		background: var(--bg);
		color: var(--fg);
		font-family: var(--font-sans);
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
	}

	/* The dark theme's glow behind the hero; it scrolls away with the page. */
	body::before {
		content: '';
		position: absolute;
		inset: 0 0 auto;
		z-index: -1;
		height: 44rem;
		background: var(--glow);
		pointer-events: none;
		mask-image: linear-gradient(to bottom, #000 50%, transparent);
	}

	a {
		color: var(--fg);
		text-underline-offset: 0.2em;
	}

	:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 3px;
	}

	::selection {
		background: var(--fg);
		color: var(--bg);
	}

	/* Action links as buttons: .btn is outlined, .btn-primary filled. */
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.75rem;
		padding: 0 1.1rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 0.6rem;
		color: var(--fg);
		font-family: var(--font-sans);
		font-size: 0.9rem;
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
	}

	.btn:hover {
		background: var(--surface-2);
		border-color: var(--fg-muted);
	}

	.btn-primary {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--on-accent);
	}

	.btn-primary:hover {
		background: color-mix(in srgb, var(--accent) 85%, var(--bg));
		border-color: color-mix(in srgb, var(--accent) 85%, var(--bg));
	}

	.btn-ghost {
		min-height: 2.25rem;
		padding: 0 0.8rem;
		background: transparent;
		border-color: transparent;
		color: var(--fg-muted);
		font-size: 0.8rem;
	}

	.btn-ghost:hover {
		border-color: var(--line);
		color: var(--fg);
	}

	@media (prefers-reduced-motion: no-preference) {
		.btn {
			transition:
				transform 0.25s var(--ease),
				background-color 0.2s,
				border-color 0.2s;
		}

		.btn:hover {
			transform: translateY(-2px);
		}
	}

	/* Small rounded tag, as in "Rio de Janeiro" or "Featured". */
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.15rem 0.65rem;
		background: var(--surface-2);
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--fg);
		font-size: 0.75rem;
		font-weight: 500;
		line-height: 1.6;
	}

	.badge .dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: #22c55e;
	}

	/* Reading progress, driven by scroll-fx with transform only. */
	.progress {
		position: fixed;
		inset: 0 0 auto;
		z-index: 20;
		height: 2px;
		background: var(--fg);
		transform: scaleX(0);
		transform-origin: 0 50%;
	}

	/* Reveal on scroll; .fx is only set when motion is allowed (see the head script). */
	.fx [data-reveal] {
		opacity: 0;
		transform: translateY(1.5rem);
	}

	.fx [data-reveal].in {
		opacity: 1;
		transform: none;
		transition:
			opacity 0.7s var(--ease),
			transform 0.8s var(--ease);
		transition-delay: var(--d, 0ms);
	}

	/* Each word rises from behind its own mask; the padding keeps accents and descenders unclipped. */
	.fx [data-split] .w {
		display: inline-block;
		overflow: hidden;
		padding-block: 0.12em;
		margin-block: -0.12em;
		vertical-align: top;
	}

	.fx [data-split] .w > span {
		display: inline-block;
		transform: translateY(115%);
	}

	.fx [data-split].in .w > span {
		transform: none;
		transition: transform 0.9s var(--ease);
		transition-delay: calc(var(--i) * 70ms + var(--d, 0ms));
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
</style>

<style>
	.skip-link {
		position: absolute;
		top: 0.5rem;
		left: 0.5rem;
		z-index: 10;
		padding: 0.5rem 0.75rem;
		background: var(--accent);
		color: var(--on-accent);
		font-weight: 600;
		transform: translateY(-200%);
	}

	.skip-link:focus {
		transform: none;
	}

	/* Translucent bar: the dark glow shows through it at the top of the page. */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 5;
		background: color-mix(in srgb, var(--bg) 80%, transparent);
		border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
		backdrop-filter: blur(12px);
		font-size: 0.875rem;
	}

	.header-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.25rem;
		max-width: var(--page-width);
		min-height: var(--header-height);
		margin: 0 auto;
		padding: 0.6rem var(--gutter);
	}

	/* Monogram tile: white on dark, black on light. */
	.brand {
		display: inline-grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		background: var(--accent);
		border-radius: 0.6rem;
		color: var(--on-accent);
		font-weight: 800;
		letter-spacing: -0.04em;
		text-decoration: none;
	}

	.site-header ul {
		display: flex;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Section links in one pill; on narrow screens the pill scrolls sideways instead of the page. */
	.sections {
		order: 3;
		flex-basis: 100%;
		min-width: 0;
	}

	.sections ul {
		gap: 0.15rem;
		width: max-content;
		max-width: 100%;
		margin-inline: auto;
		padding: 0.25rem;
		overflow-x: auto;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 999px;
		scrollbar-width: none;
	}

	.sections a {
		display: block;
		padding: 0.3rem 0.8rem;
		border-radius: 999px;
		color: var(--fg-muted);
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
	}

	.sections a:hover {
		color: var(--fg);
	}

	/* The section on screen (set by scroll-fx). */
	.sections a[aria-current] {
		background: var(--surface-2);
		color: var(--fg);
	}

	@media (prefers-reduced-motion: no-preference) {
		.sections a {
			transition:
				background-color 0.2s,
				color 0.2s;
		}
	}

	.tools {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-left: auto;
	}

	.languages ul {
		gap: 0.15rem;
		padding: 0.2rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 999px;
	}

	.languages a {
		display: block;
		padding: 0.15rem 0.6rem;
		border-radius: 999px;
		color: var(--fg-muted);
		font-size: 0.75rem;
		font-weight: 600;
		text-decoration: none;
	}

	.languages a[aria-current='page'] {
		background: var(--accent);
		color: var(--on-accent);
	}

	/* Shows the theme it switches to: the sun on dark, the moon on light. */
	.theme-toggle {
		display: inline-grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 50%;
		color: var(--fg-muted);
		cursor: pointer;
	}

	.theme-toggle[hidden] {
		display: none;
	}

	.theme-toggle:hover {
		color: var(--fg);
	}

	.theme-toggle svg {
		width: 1.05rem;
		height: 1.05rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.75;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.theme-toggle[aria-pressed='true'] .icon-sun,
	.theme-toggle[aria-pressed='false'] .icon-moon {
		display: none;
	}

	/* Wide screens: brand, pill and tools on one line. */
	@media (min-width: 62rem) {
		.sections {
			order: 0;
			flex: 1;
			flex-basis: auto;
		}
	}
</style>
