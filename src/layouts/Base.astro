---
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoLatin from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
import {
	defaultLocale,
	isLocale,
	localeNames,
	localeTags,
	locales,
	useTranslations,
	type Locale,
} from '../i18n/ui';

interface Props {
	title?: string;
	description?: string;
	/** Pages outside the locale tree (the 404): no canonical/hreflang, not indexed, language links go home. */
	standalone?: boolean;
	/** Locale for standalone pages, which Astro cannot infer from the URL. */
	locale?: Locale;
}

const { standalone = false } = Astro.props;
const locale: Locale = Astro.props.locale ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale);
const t = useTranslations(locale);
const { title = t('site.title'), description = t('site.description') } = Astro.props;

// Path after the locale segment, so the language switch keeps the same page.
const pathInLocale = standalone ? '' : Astro.url.pathname.replace(/^\/(en|pt)(\/|$)/, '');
const canonical = getAbsoluteLocaleUrl(locale, pathInLocale);
// One share image per locale (generated by `npm run og`).
const ogImage = new URL(`/og/og-${locale}.png`, Astro.site).href;

// Section anchors point at the home page so they also work from other pages.
const home = getRelativeLocaleUrl(locale);
const sections = [
	{ id: 'projects', label: t('nav.projects') },
	{ id: 'about', label: t('nav.about') },
	{ id: 'stack', label: t('nav.stack') },
	{ id: 'activity', label: t('nav.activity') },
	{ id: 'signals', label: t('nav.signals') },
	{ id: 'pipeline', label: t('nav.pipeline') },
	{ id: 'contact', label: t('nav.contact') },
];

// Self-hosted fonts, Latin subset only (covers Portuguese accents).
const latinRange =
	'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fontFaces = `
@font-face{font-family:'Inter Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${interLatin}) format('woff2-variations');unicode-range:${latinRange}}
@font-face{font-family:'JetBrains Mono';font-style:normal;font-display:swap;font-weight:400;src:url(${monoLatin}) format('woff2');unicode-range:${latinRange}}
`;
---

<!doctype html>
<html lang={localeTags[locale]}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#070D1C" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
		<style is:inline set:html={fontFaces} />
		<script is:inline>
			// Hide reveal targets before first paint, unless the visitor prefers reduced motion.
			// If scroll-fx never starts (blocked or failed), show everything after 2.5 s.
			(function () {
				var d = document.documentElement;
				if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
				d.classList.add('fx');
				setTimeout(function () {
					if (!d.hasAttribute('data-fx-ready')) d.classList.remove('fx');
				}, 2500);
			})();
		</script>

		{
			standalone ? (
				<meta name="robots" content="noindex" />
			) : (
				<>
					<link rel="canonical" href={canonical} />
					{locales.map((l) => (
						<link rel="alternate" hreflang={localeTags[l]} href={getAbsoluteLocaleUrl(l, pathInLocale)} />
					))}
					<link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl(defaultLocale, pathInLocale)} />
				</>
			)
		}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="João Abreu" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={t('og.alt')} />
		<meta property="og:locale" content={localeTags[locale].replace('-', '_')} />
		{
			locales
				.filter((l) => l !== locale)
				.map((l) => <meta property="og:locale:alternate" content={localeTags[l].replace('-', '_')} />)
		}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={ogImage} />
		<slot name="head" />
	</head>
	<body>
		<div class="progress" aria-hidden="true"></div>
		<a class="skip-link" href="#main">{t('nav.skip')}</a>
		<header class="site-header">
			<div class="header-inner">
				<a class="brand" href={home}>JA<span>/</span></a>
				<nav class="sections" aria-label={t('nav.sections')}>
					<ul>
						{
							sections.map((s) => (
								<li>
									<a href={`${home}#${s.id}`}>{s.label}</a>
								</li>
							))
						}
					</ul>
				</nav>
				<nav class="languages" aria-label={t('nav.language')}>
					<ul>
						{
							locales.map((l) => (
								<li>
									<a
										href={getRelativeLocaleUrl(l, pathInLocale)}
										hreflang={localeTags[l]}
										lang={localeTags[l]}
										aria-current={l === locale ? 'page' : undefined}
									>
										{l.toUpperCase()}
										<span class="visually-hidden">{localeNames[l]}</span>
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
		</header>
		<slot />
		<script>
			import '../scripts/scroll-fx';
			import '../scripts/sonar';
		</script>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: dark;
		/* Sonar palette: navy background, lightened BIC blue as the accent. */
		--bg: #070d1c;
		--surface: #0b1428;
		--line: #1f3d99; /* BIC blue: borders and rings only, never text */
		--fg: #e3e8f7;
		--fg-muted: #8f9ab8;
		--accent: #6f8cff;
		--font-sans: 'Inter Variable', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
		--font-mono: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
		--header-height: 3.5rem;
		--page-width: 76rem;
		--gutter: clamp(1rem, 4vw, 2.5rem);
		--ease: cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		/* Room for the sticky header, which wraps to two lines on narrow phones. */
		scroll-padding-top: 6.5rem;
	}

	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}
	}

	body {
		margin: 0;
		min-height: 100vh;
		background: var(--bg);
		color: var(--fg);
		font-family: var(--font-sans);
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
	}

	a {
		color: var(--accent);
		text-underline-offset: 0.2em;
	}

	:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	::selection {
		background: var(--line);
		color: var(--fg);
	}

	/* Action links as buttons: .btn is outlined, .btn-primary filled (dark text on the accent, 6.3:1). */
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.75rem;
		padding: 0 1.1rem;
		background: transparent;
		border: 1px solid var(--line);
		border-radius: 0.5rem;
		color: var(--fg);
		font-family: var(--font-sans);
		font-size: 0.95rem;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}

	.btn:hover {
		background: var(--surface);
		border-color: var(--accent);
	}

	.btn-primary {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--bg);
	}

	.btn-primary:hover {
		background: color-mix(in srgb, var(--accent) 85%, var(--fg));
		border-color: color-mix(in srgb, var(--accent) 85%, var(--fg));
	}

	.btn-ghost {
		min-height: 2.25rem;
		padding: 0 0.8rem;
		border-color: transparent;
		color: var(--fg-muted);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 400;
	}

	.btn-ghost:hover {
		border-color: var(--line);
		color: var(--fg);
	}

	@media (prefers-reduced-motion: no-preference) {
		.btn {
			transition:
				transform 0.25s var(--ease),
				background-color 0.2s,
				border-color 0.2s;
		}

		.btn:hover {
			transform: translateY(-2px);
		}
	}

	/* Reading progress, driven by scroll-fx with transform only. */
	.progress {
		position: fixed;
		inset: 0 0 auto;
		z-index: 20;
		height: 2px;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: 0 50%;
	}

	/* Reveal on scroll; .fx is only set when motion is allowed (see the head script). */
	.fx [data-reveal] {
		opacity: 0;
		transform: translateY(1.5rem);
	}

	.fx [data-reveal].in {
		opacity: 1;
		transform: none;
		transition:
			opacity 0.7s var(--ease),
			transform 0.8s var(--ease);
		transition-delay: var(--d, 0ms);
	}

	/* Each word rises from behind its own mask; the padding keeps accents and descenders unclipped. */
	.fx [data-split] .w {
		display: inline-block;
		overflow: hidden;
		padding-block: 0.12em;
		margin-block: -0.12em;
		vertical-align: top;
	}

	.fx [data-split] .w > span {
		display: inline-block;
		transform: translateY(115%);
	}

	.fx [data-split].in .w > span {
		transform: none;
		transition: transform 0.9s var(--ease);
		transition-delay: calc(var(--i) * 70ms + var(--d, 0ms));
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
</style>

<style>
	.skip-link {
		position: absolute;
		top: 0.5rem;
		left: 0.5rem;
		z-index: 10;
		padding: 0.5rem 0.75rem;
		background: var(--accent);
		color: var(--bg);
		font-weight: 600;
		transform: translateY(-200%);
	}

	.skip-link:focus {
		transform: none;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 5;
		background: var(--bg);
		border-bottom: 1px solid var(--line);
		font-family: var(--font-mono);
		font-size: 0.8rem;
	}

	.header-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1.5rem;
		max-width: var(--page-width);
		min-height: var(--header-height);
		margin: 0 auto;
		padding: 0.5rem var(--gutter);
	}

	.brand {
		color: var(--fg);
		font-weight: 400;
		letter-spacing: 0.1em;
		text-decoration: none;
	}

	.brand span {
		color: var(--accent);
	}

	.site-header ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.sections {
		flex: 1;
	}

	.sections a {
		position: relative;
		color: var(--fg-muted);
		text-decoration: none;
	}

	.sections a:hover,
	.sections a[aria-current] {
		color: var(--fg);
	}

	/* Underline for the section on screen (set by scroll-fx). */
	.sections a::after {
		content: '';
		position: absolute;
		inset: auto 0 -0.3rem;
		height: 1px;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: left;
	}

	.sections a[aria-current]::after {
		transform: scaleX(1);
	}

	@media (prefers-reduced-motion: no-preference) {
		.sections a::after {
			transition: transform 0.4s var(--ease);
		}
	}

	.languages a {
		color: var(--fg-muted);
		text-decoration: none;
	}

	.languages a[aria-current='page'] {
		color: var(--accent);
	}

	/* Section links centered between the brand and the language switch on wide screens. */
	@media (min-width: 48rem) {
		.sections ul {
			justify-content: center;
		}
	}
</style>
