---
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n';
import { createHash } from 'node:crypto';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoLatin from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
import {
	defaultLocale,
	isLocale,
	localeNames,
	localeTags,
	locales,
	useTranslations,
	type Locale,
} from '../i18n/ui';
import { getContacts } from '../lib/content';

interface Props {
	title?: string;
	description?: string;
	/** Pages outside the locale tree (the 404): no canonical/hreflang, not indexed, language links go home. */
	standalone?: boolean;
	/** Locale for standalone pages, which Astro cannot infer from the URL. */
	locale?: Locale;
}

const { standalone = false } = Astro.props;
const locale: Locale = Astro.props.locale ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale);
const t = useTranslations(locale);
const { title = t('site.title'), description = t('site.description') } = Astro.props;

// Path after the locale segment, so the language switch keeps the same page.
const pathInLocale = standalone ? '' : Astro.url.pathname.replace(/^\/(en|pt)(\/|$)/, '');
const canonical = getAbsoluteLocaleUrl(locale, pathInLocale);
// One share image per locale (generated by `npm run og`).
const ogImage = new URL(`/og/og-${locale}.png`, Astro.site).href;

// One page per section. The current page shows its icon and name in the pill; the others only the icon.
const home = getRelativeLocaleUrl(locale);
const pages = [
	{ id: '', label: t('nav.home'), icon: 'M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1Z' },
	{ id: 'projects', label: t('nav.projects'), icon: 'M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z' },
	{ id: 'blog', label: t('nav.blog'), icon: 'M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Zm0 0v6h6M8 13h8m-8 4h5' },
	{ id: 'resume', label: t('nav.resume'), icon: 'M4 8h16v12H4Zm5 0V5h6v3m-11 5h16' },
	{ id: 'contact', label: t('nav.contact'), icon: 'M3 6h18v12H3Zm0 1 9 6 9-6' },
].map((p) => ({
	...p,
	href: getRelativeLocaleUrl(locale, p.id ? `${p.id}/` : ''),
	current: !standalone && (p.id === '' ? pathInLocale === '' : pathInLocale.startsWith(p.id)),
}));
const socials = (await getContacts()).filter((c) => c.kind !== 'email');

// Self-hosted fonts, Latin subset only (covers Portuguese accents).
const latinRange =
	'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fontFaces = `
@font-face{font-family:'Inter Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${interLatin}) format('woff2-variations');unicode-range:${latinRange}}
@font-face{font-family:'JetBrains Mono';font-style:normal;font-display:swap;font-weight:400;src:url(${monoLatin}) format('woff2');unicode-range:${latinRange}}
`;
// Runs before the first paint so the page never flashes the wrong theme: stored choice, else the system.
const themeBootstrap = `(function(){var d=document.documentElement,t=null;try{t=localStorage.getItem('theme')}catch(e){}if(t!=='light'&&t!=='dark')t=matchMedia('(prefers-color-scheme: light)').matches?'light':'dark';d.setAttribute('data-theme',t);var m=document.querySelector('meta[name="theme-color"]');if(m)m.setAttribute('content',t==='light'?'#FFFFFF':'#11141b')})();`;
// Hash the exact inline payloads; changing any of them automatically changes its CSP allowance.
const revealBootstrap = `(function(){var d=document.documentElement;if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;d.classList.add('fx');setTimeout(function(){if(!d.hasAttribute('data-fx-ready'))d.classList.remove('fx')},2500)})();`;
Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(themeBootstrap).digest('base64')}`);
Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(revealBootstrap).digest('base64')}`);
Astro.csp?.insertStyleHash(`sha256-${createHash('sha256').update(fontFaces).digest('base64')}`);
---

<!doctype html>
<html lang={localeTags[locale]}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#11141b" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
		<style is:inline set:html={fontFaces} />
		<script is:inline set:html={themeBootstrap} />
		<script is:inline set:html={revealBootstrap} />

		{
			standalone ? (
				<meta name="robots" content="noindex" />
			) : (
				<>
					<link rel="canonical" href={canonical} />
					{locales.map((l) => (
						<link rel="alternate" hreflang={localeTags[l]} href={getAbsoluteLocaleUrl(l, pathInLocale)} />
					))}
					<link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl(defaultLocale, pathInLocale)} />
				</>
			)
		}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="João Abreu" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={t('og.alt')} />
		<meta property="og:locale" content={localeTags[locale].replace('-', '_')} />
		{
			locales
				.filter((l) => l !== locale)
				.map((l) => <meta property="og:locale:alternate" content={localeTags[l].replace('-', '_')} />)
		}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={ogImage} />
		<slot name="head" />
	</head>
	<body>
		<div class="wallpaper" aria-hidden="true"><span></span><span></span><span></span></div>
		<div class="progress" aria-hidden="true"></div>
		<a class="skip-link" href="#main">{t('nav.skip')}</a>
		<header class="site-header">
			<div class="header-inner">
				<a class="brand" href={home}>
					<span class="brand-mark" aria-hidden="true">JA</span>
					<span class="brand-name">João Abreu</span>
				</a>
				<nav class="sections" aria-label={t('nav.main')}>
					<ul>
						{
							pages.map((p) => (
								<li>
									<a href={p.href} aria-current={p.current ? 'page' : undefined} title={p.label}>
										<svg viewBox="0 0 24 24" aria-hidden="true">
											<path d={p.icon} />
										</svg>
										<span class:list={['label', { 'visually-hidden': !p.current }]}>{p.label}</span>
									</a>
								</li>
							))
						}
					</ul>
				</nav>
				<div class="tools">
					<nav class="languages" aria-label={t('nav.language')}>
						<ul>
							{
								locales.map((l) => (
									<li>
										<a
											href={getRelativeLocaleUrl(l, pathInLocale)}
											hreflang={localeTags[l]}
											lang={localeTags[l]}
											aria-current={l === locale ? 'page' : undefined}
										>
											{l.toUpperCase()}
											<span class="visually-hidden">{localeNames[l]}</span>
										</a>
									</li>
								))
							}
						</ul>
					</nav>
					<!-- Shown by scripts/theme.ts; without JavaScript the page simply follows the system theme. -->
					<button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" title={t('nav.theme')} hidden>
						<svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
							<circle cx="12" cy="12" r="4"></circle>
							<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
						</svg>
						<svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
						</svg>
						<span class="visually-hidden">{t('nav.theme')}</span>
					</button>
				</div>
			</div>
		</header>
		<slot />
		<footer class="site-footer">
			<div class="footer-inner">
				<div class="footer-brand">
					<a class="brand" href={home}>
						<span class="brand-mark" aria-hidden="true">JA</span>
						<span>João Abreu</span>
					</a>
					<p>{t('home.role')}</p>
				</div>
				<nav aria-label={t('footer.navigation')}>
					<h2>{t('footer.navigation')}</h2>
					<ul>
						{
							pages.map((p) => (
								<li>
									<a href={p.href}>{p.label}</a>
								</li>
							))
						}
					</ul>
				</nav>
				<nav aria-label={t('footer.social')}>
					<h2>{t('footer.social')}</h2>
					<ul>
						{
							socials.map((c) => (
								<li>
									<a href={c.url}>{c.label} ↗</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
			<p class="footer-note">© {new Date().getFullYear()} João Abreu · {t('footer.note')}</p>
		</footer>
		<script>
			import '../scripts/theme';
			import '../scripts/scroll-fx';
		</script>
	</body>
</html>

<style is:global>
	/*
	 * v3 palettes. Dark: soft slate gray under blue wallpapers at the top (.wallpaper below, in the spirit of developer.org.tr).
	 * Light: white, near-black ink, hairline borders and the same wallpapers, lighter. Both use a vivid blue accent.
	 * Kept in two places on purpose: [data-theme] is set by the head script, the media query covers
	 * visitors without JavaScript. Change both together (and the bar colors in scripts/theme.ts).
	 */
	:root {
		color-scheme: dark;
		--bg: #11141b;
		--surface: #181c25;
		--surface-2: #1e232e;
		--line: #2b313d;
		--fg: #fafafa;
		--fg-muted: #a1a1aa;
		--accent: #2563eb;
		--brand: #60a5fa;
		--brand-2: #38bdf8;
		--on-accent: #ffffff;
		--heat: #39d353;
		--font-sans: 'Inter Variable', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
		--font-mono: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
		--header-height: 4rem;
		--page-width: 68rem;
		--gutter: clamp(1rem, 4vw, 2.5rem);
		--radius: 1rem;
		--ease: cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	:root[data-theme='light'] {
		color-scheme: light;
		--bg: #ffffff;
		--surface: #ffffff;
		--surface-2: #f5f5f5;
		--line: #e5e5e5;
		--fg: #171717;
		--fg-muted: #5c5c5c;
		--accent: #2563eb;
		--brand: #2563eb;
		--brand-2: #0ea5e9;
		--on-accent: #ffffff;
		--heat: #16a34a;
	}

	@media (prefers-color-scheme: light) {
		:root:not([data-theme]) {
			color-scheme: light;
			--bg: #ffffff;
			--surface: #ffffff;
			--surface-2: #f5f5f5;
			--line: #e5e5e5;
			--fg: #171717;
			--fg-muted: #5c5c5c;
			--accent: #2563eb;
			--brand: #2563eb;
			--brand-2: #0ea5e9;
			--on-accent: #ffffff;
			--heat: #16a34a;
		}
	}

	/*
	 * Theme switch animation (scripts/theme.ts). With the View Transitions API the new theme grows
	 * as a circle from the toggle; the default cross-fade is turned off so only the circle moves.
	 * Browsers without it get a short color fade through the .theme-fading class instead.
	 */
	::view-transition-old(root),
	::view-transition-new(root) {
		animation: none;
		mix-blend-mode: normal;
	}

	.theme-fading,
	.theme-fading *,
	.theme-fading *::before,
	.theme-fading *::after {
		transition:
			background-color 0.45s var(--ease),
			border-color 0.45s var(--ease),
			color 0.45s var(--ease),
			fill 0.45s var(--ease) !important;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		/* Room for the sticky header, which wraps to two lines on narrow phones. */
		scroll-padding-top: 7.5rem;
	}

	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}
	}

	body {
		position: relative;
		isolation: isolate;
		margin: 0;
		min-height: 100vh;
		background: var(--bg);
		color: var(--fg);
		font-family: var(--font-sans);
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
	}

	/*
	 * Wallpaper behind the top of the page (public/img/wallpapers, drawn for this
	 * site). Three wallpapers cross-fade slowly, animating opacity only; with reduced motion the
	 * first one stays. The mask fades it into the background; it scrolls away with the page.
	 */
	.wallpaper {
		position: absolute;
		inset: 0 0 auto;
		z-index: -1;
		height: 60rem;
		pointer-events: none;
		mask-image: linear-gradient(to top, transparent 10%, rgb(0 0 0 / 0.3), #000);
	}

	.wallpaper span {
		position: absolute;
		inset: 0;
		background: center top / cover no-repeat;
		opacity: 0;
	}

	.wallpaper span:nth-child(1) {
		background-image: url('/img/wallpapers/1.svg');
		opacity: 1;
	}

	.wallpaper span:nth-child(2) {
		background-image: url('/img/wallpapers/2.svg');
	}

	.wallpaper span:nth-child(3) {
		background-image: url('/img/wallpapers/3.svg');
	}

	/* Light theme: the same wallpapers, lighter, like a bright sky behind the title. */
	:root[data-theme='light'] .wallpaper {
		mask-image: linear-gradient(to top, transparent 15%, rgb(0 0 0 / 0.08), rgb(0 0 0 / 0.4));
	}

	@media (prefers-color-scheme: light) {
		:root:not([data-theme]) .wallpaper {
			mask-image: linear-gradient(to top, transparent 15%, rgb(0 0 0 / 0.08), rgb(0 0 0 / 0.4));
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		/* 30 s cycle: each wallpaper fades in over 3 s, stays 7 s, fades out while the next comes in. */
		.wallpaper span {
			animation: wallpaper 30s linear infinite;
		}

		.wallpaper span:nth-child(1) {
			animation-delay: -3s;
		}

		.wallpaper span:nth-child(2) {
			animation-delay: 7s;
		}

		.wallpaper span:nth-child(3) {
			animation-delay: 17s;
		}
	}

	@keyframes wallpaper {
		0% {
			opacity: 0;
		}
		10%,
		33.3% {
			opacity: 1;
		}
		43.3%,
		100% {
			opacity: 0;
		}
	}

	a {
		color: var(--fg);
		text-underline-offset: 0.2em;
	}

	:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 3px;
	}

	::selection {
		background: var(--fg);
		color: var(--bg);
	}

	/* Action links as buttons: .btn is outlined, .btn-primary filled. */
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.75rem;
		padding: 0 1.1rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 0.6rem;
		color: var(--fg);
		font-family: var(--font-sans);
		font-size: 0.9rem;
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
	}

	.btn:hover {
		background: var(--surface-2);
		border-color: var(--fg-muted);
	}

	.btn-primary {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--on-accent);
	}

	.btn-primary:hover {
		background: color-mix(in srgb, var(--accent) 85%, var(--bg));
		border-color: color-mix(in srgb, var(--accent) 85%, var(--bg));
	}

	.btn-ghost {
		min-height: 2.25rem;
		padding: 0 0.8rem;
		background: transparent;
		border-color: transparent;
		color: var(--fg-muted);
		font-size: 0.8rem;
	}

	.btn-ghost:hover {
		border-color: var(--line);
		color: var(--fg);
	}

	@media (prefers-reduced-motion: no-preference) {
		.btn {
			transition:
				transform 0.25s var(--ease),
				background-color 0.2s,
				border-color 0.2s;
		}

		.btn:hover {
			transform: translateY(-2px);
		}
	}

	/* Small rounded tag, as in "Rio de Janeiro" or "Featured". */
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.15rem 0.65rem;
		background: var(--surface-2);
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--fg);
		font-size: 0.75rem;
		font-weight: 500;
		line-height: 1.6;
	}

	.badge .dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: #22c55e;
	}

	/* ---- Shared page building blocks ---- */

	.page {
		max-width: var(--page-width);
		margin: 0 auto;
		padding: 0 var(--gutter);
		overflow-wrap: anywhere;
	}

	/* Page title over the wallpaper: big title, one short line below. */
	.page-head {
		padding-block: clamp(3.5rem, 10vw, 6rem) 2.5rem;
	}

	.page-head h1 {
		margin: 0;
		font-size: clamp(2.5rem, 7vw, 3.5rem);
		font-weight: 700;
		letter-spacing: -0.035em;
		line-height: 1.05;
	}

	.page-head p {
		max-width: 34rem;
		margin: 0.75rem 0 0;
		color: var(--fg-muted);
		font-size: 1.05rem;
	}

	.band {
		padding-block: 2.5rem;
	}

	.band-head {
		margin-bottom: 1.25rem;
	}

	.band-head h2 {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0;
		font-size: clamp(1.4rem, 3vw, 1.75rem);
		letter-spacing: -0.025em;
	}

	.band-head h2 svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: none;
		stroke: var(--brand);
		stroke-width: 1.75;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.band-head p {
		margin: 0.35rem 0 0;
		color: var(--fg-muted);
	}

	.card {
		position: relative;
		isolation: isolate;
		padding: 1.5rem;
		background: color-mix(in srgb, var(--surface) 92%, transparent);
		border: 1px solid var(--line);
		border-radius: var(--radius);
	}

	.muted {
		color: var(--fg-muted);
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.8rem;
	}

	.chips li {
		padding: 0.1rem 0.6rem;
		background: var(--surface-2);
		border: 1px solid var(--line);
		border-radius: 999px;
		font-weight: 500;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Reading progress, driven by scroll-fx with transform only. */
	.progress {
		position: fixed;
		inset: 0 0 auto;
		z-index: 20;
		height: 2px;
		background: linear-gradient(90deg, var(--brand-2), var(--accent), #6366f1);
		transform: scaleX(0);
		transform-origin: 0 50%;
	}

	/* Reveal on scroll; .fx is only set when motion is allowed (see the head script). */
	.fx [data-reveal] {
		opacity: 0;
		transform: translateY(1.5rem);
	}

	.fx [data-reveal].in {
		opacity: 1;
		transform: none;
		transition:
			opacity 0.7s var(--ease),
			transform 0.8s var(--ease);
		transition-delay: var(--d, 0ms);
	}

	/* Each word rises from behind its own mask; the padding keeps accents and descenders unclipped. */
	.fx [data-split] .w {
		display: inline-block;
		overflow: hidden;
		padding-block: 0.12em;
		margin-block: -0.12em;
		vertical-align: top;
	}

	.fx [data-split] .w > span {
		display: inline-block;
		transform: translateY(115%);
	}

	.fx [data-split].in .w > span {
		transform: none;
		transition: transform 0.9s var(--ease);
		transition-delay: calc(var(--i) * 70ms + var(--d, 0ms));
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
</style>

<style>
	.skip-link {
		position: absolute;
