---
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import { createHash } from "node:crypto";
import { localeTags, type Locale } from "../i18n/ui";
import { adminUi } from "../i18n/admin";
import "../styles/admin.css";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const labels = adminUi[locale];
const bootstrap = `try{var t=localStorage.getItem('theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}`;
const fonts = `@font-face{font-family:Inter;src:url('${interLatin}') format('woff2');font-style:normal;font-weight:100 900;font-display:swap}`;
Astro.csp?.insertScriptHash(
  `sha256-${createHash("sha256").update(bootstrap).digest("base64")}`,
);
Astro.csp?.insertStyleHash(
  `sha256-${createHash("sha256").update(fonts).digest("base64")}`,
);
---

<!doctype html>
<html lang={localeTags[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="same-origin" />
    <title>{labels.title} · João Abreu</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href={interLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style is:inline set:html={fonts} />
    <script is:inline set:html={bootstrap} />
  </head>
  <body>
    <slot />
  </body>
</html>
