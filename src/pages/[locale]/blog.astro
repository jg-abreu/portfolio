---
// Blog, modeled on developer.org.tr: João's published DEV articles from the build snapshot, as
// cards with the post image, title, tags and date. Each card links to the article on DEV; the body
// is never copied here. A new article shows up on the next build (every push and once a day).
import Base from '../../layouts/Base.astro';
import { localeTags, locales, useTranslations, type Locale } from '../../i18n/ui';
import { getGitHubSnapshot } from '../../lib/github';
import { DEVTO_USER } from '../../lib/github-data';

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
const dateFormat = new Intl.DateTimeFormat(localeTags[locale], { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' });
const articles = getGitHubSnapshot()?.articles ?? [];
---

<Base title={`${t('nav.blog')} - João Abreu`} description={t('blog.body')}>
	<main id="main" class="page">
		<header class="page-head">
			<h1 data-split>{t('nav.blog')}</h1>
			<p data-reveal>{t('blog.body')}</p>
		</header>

		{
			articles.length > 0 ? (
				<ul class="grid articles">
					{articles.map((a, i) => (
						<li class="card post" data-reveal style={`--d: ${i * 100}ms`}>
							{a.image && (
								<div class="image">
									<img src={a.image} alt="" width="1200" height="627" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
								</div>
							)}
							<h2>
								<a href={a.url}>{a.title}</a>
							</h2>
							{a.tags.length > 0 && (
								<ul class="tags">
									{a.tags.map((tag) => (
										<li>#{tag}</li>
									))}
								</ul>
							)}
							<p class="meta">
								<span>
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path d="M4 6h16v14H4Zm0 4h16M8 3v4m8-4v4" />
									</svg>
									<time datetime={a.publishedAt}>{dateFormat.format(new Date(`${a.publishedAt}T00:00:00Z`))}</time>
								</span>
								{a.readingMinutes > 0 && <span>{t('blog.minutes').replace('{n}', String(a.readingMinutes))}</span>}
							</p>
						</li>
					))}
				</ul>
			) : (
				<p class="muted">{t('blog.empty')}</p>
			)
		}

		<p class="all" data-reveal>
			<a class="btn" href={`https://dev.to/${DEVTO_USER}`}>{t('blog.all')} ↗</a>
		</p>
	</main>
</Base>

<script>
	import '../../scripts/card-glow';
</script>

<style>
	.articles {
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
		align-items: start;
	}

	.post {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		padding: 1rem 1rem 1.1rem;
	}

	.image {
		aspect-ratio: 16 / 9;
		margin-bottom: 0.35rem;
		overflow: hidden;
		background: var(--surface-2);
		border-radius: 0.6rem;
	}

	.image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	h2 {
		display: -webkit-box;
		margin: 0;
		overflow: hidden;
		font-size: 1.05rem;
		letter-spacing: -0.015em;
		line-height: 1.35;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
	}

	h2 a {
		color: var(--fg);
		text-decoration: none;
	}

	/* The whole card is the link's target. */
	h2 a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.post:hover h2 a {
		color: var(--brand);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tags li {
		padding: 0.05rem 0.4rem;
		background: color-mix(in srgb, var(--accent) 18%, transparent);
		border-radius: 0.3rem;
		color: var(--brand);
		font-size: 0.7rem;
		font-weight: 500;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1rem;
		margin: 0.2rem 0 0;
		color: var(--fg-muted);
		font-size: 0.8rem;
	}

	.meta span {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.meta svg {
		width: 0.9rem;
		height: 0.9rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.75;
		stroke-linecap: round;
	}

	.all {
		margin: 2rem 0;
	}

	@media (prefers-reduced-motion: no-preference) {
		.post {
			transition:
				transform 0.25s var(--ease),
				border-color 0.2s;
		}

		.post:hover {
			border-color: var(--fg-muted);
			transform: translateY(-2px);
		}

		.image img {
			transition: transform 0.5s var(--ease);
		}

		.post:hover .image img {
			transform: scale(1.03);
		}
	}
</style>
