---
// Résumé: a short "about", what João is working on now, and the PDF in the page's language.
// The PDF is shown in an iframe from the same site; production must allow same-origin framing
// (nginx sends X-Frame-Options: DENY today, see the PR notes), otherwise the fallback link remains.
import Base from '../../layouts/Base.astro';
import { locales, useTranslations, type Locale } from '../../i18n/ui';
import { getAbout, getResumePath } from '../../lib/content';

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
const about = await getAbout(locale);
const resumePath = getResumePath(locale);
---

<Base title={`${t('nav.resume')} - João Abreu`} description={t('resume.body')}>
	<main id="main" class="page">
		<header class="page-head">
			<h1 data-split>{t('nav.resume')}</h1>
			<p data-reveal>{t('resume.body')}</p>
			{
				resumePath && (
					<p class="actions" data-reveal style="--d: 150ms">
						<a class="btn btn-primary" href={resumePath} download>
							{t('resume.download')}
						</a>
						<a class="btn" href={resumePath} target="_blank" rel="noopener">
							{t('resume.open')} ↗
						</a>
					</p>
				)
			}
		</header>

		<!--
			The PDF right under the buttons, as on developer.org.tr. Its src is set by the script below
			once the page has loaded, so the PDF never holds up the page (or the intro loader).
		-->
		{
			resumePath && (
				<section class="viewer" data-reveal style="--d: 250ms" aria-label={t('resume.pdf')}>
					<iframe data-src={resumePath} title={t('resume.pdf')} />
					<noscript>
						<iframe src={resumePath} title={t('resume.pdf')} />
					</noscript>
					<p class="fallback muted">
						{t('resume.fallback')}{' '}
						<a href={resumePath} target="_blank" rel="noopener">
							{t('resume.open')} ↗
						</a>
					</p>
				</section>
			)
		}

		<section class="about" aria-labelledby="about-heading">
			<div data-reveal>
				<h2 id="about-heading">{t('about.title')}</h2>
				{about.paragraphs.map((p) => <p class="lead">{p}</p>)}
			</div>
			<div class="card now" data-reveal style="--d: 100ms">
				<h2>{t('about.now')}</h2>
				<ul>
					{about.now.map((item) => <li>{item}</li>)}
				</ul>
			</div>
		</section>
	</main>
</Base>

<script>
	// Loads the PDF after the page itself, keeping the reader where they are: Chrome's PDF viewer
	// scrolls the page to itself while it starts up, so for a few seconds any scroll the reader did
	// not make (wheel, touch, keys, scrollbar) is undone.
	const frame = document.querySelector<HTMLIFrameElement>('iframe[data-src]');
	const start = () => {
		if (!frame?.dataset.src) return;
		const x = scrollX;
		const y = scrollY;
		let guarding = true;
		const release = () => {
			guarding = false;
			removeEventListener('scroll', hold);
		};
		const hold = () => {
			if (guarding && (scrollX !== x || scrollY !== y)) scrollTo(x, y);
		};
		for (const type of ['wheel', 'touchstart', 'keydown', 'pointerdown']) {
			addEventListener(type, release, { once: true, passive: true });
		}
		addEventListener('scroll', hold, { passive: true });
		setTimeout(release, 4000);
		frame.src = frame.dataset.src;
	};
	if (document.readyState === 'complete') start();
	else addEventListener('load', start, { once: true });
</script>

<style>
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 1.5rem 0 0;
	}

	.about {
		display: grid;
		gap: 1.5rem;
		align-items: start;
		padding-block: 1rem 2.5rem;
	}

	h2 {
		margin: 0 0 1rem;
		font-size: 1.35rem;
		letter-spacing: -0.02em;
	}

	.lead {
		margin: 0 0 1.1rem;
		color: var(--fg-muted);
		line-height: 1.75;
	}

	.now h2 {
		font-size: 1rem;
	}

	.now ul {
		display: grid;
		gap: 0.6rem;
		margin: 0;
		padding-left: 1.1rem;
		color: var(--fg-muted);
	}

	.viewer {
		margin: 0.5rem 0 3.5rem;
	}

	iframe {
		display: block;
		width: 100%;
		height: min(85vh, 62rem);
		background: var(--surface-2);
		border: 1px solid var(--line);
		border-radius: 0.75rem;
	}

	.fallback {
		margin: 0.75rem 0.5rem 0.25rem;
		font-size: 0.85rem;
	}

	@media (min-width: 60rem) {
		.about {
			grid-template-columns: 3fr 2fr;
			gap: 3rem;
		}
	}
</style>
