---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../../../layouts/Base.astro';
import { locales, localeTags, useTranslations, type Locale } from '../../../i18n/ui';
import { getBlogArticles } from '../../../lib/blog-data';
import type { BlogArticle } from '../../../lib/blog';
import { renderArticleMarkdown } from '../../../lib/publication-markdown';

export function getStaticPaths() {
  return locales.flatMap(locale => getBlogArticles().map(article => ({
    params: { locale, slug: article.slug }, props: { article },
  })));
}

const { article } = Astro.props as { article: BlogArticle };
const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
const published = new Intl.DateTimeFormat(localeTags[locale], {
  dateStyle: 'long', timeZone: 'UTC',
}).format(new Date(`${article.publishedAt}T00:00:00Z`));
const html = article.bodyMarkdown === null ? '' : renderArticleMarkdown(article.bodyMarkdown);
---

<Base title={`${article.title} - João Abreu`} description={article.description ?? t('blog.body')} shareTitle={article.title}>
  <main id="main" class="reading-page">
    <article>
      <header>
        <a class="back" href={getRelativeLocaleUrl(locale, 'blog/')}>← {t('blog.back')}</a>
        <h1>{article.title}</h1>
        <p class="meta"><time datetime={article.publishedAt}>{published}</time>
          {article.readingMinutes > 0 && <span> · {t('blog.minutes').replace('{n}', new Intl.NumberFormat(localeTags[locale]).format(article.readingMinutes))}</span>}
        </p>
        {article.tags.length > 0 && <ul class="tags">{article.tags.map(tag => <li>#{tag}</li>)}</ul>}
      </header>
      {article.image && <img class="cover" src={article.image} alt="" width="1200" height="627" decoding="async" referrerpolicy="no-referrer" />}
      {html ? <div class="article-body" set:html={html} /> : <p class="unavailable">{t('blog.unavailable')}</p>}
      <footer>
        <a class="btn btn-ghost" href={getRelativeLocaleUrl(locale, 'blog/')}>← {t('blog.back')}</a>
        <a href={article.url} rel="noopener noreferrer">{t('blog.original')} ↗</a>
      </footer>
    </article>
  </main>
</Base>

<style>
  .reading-page { width: min(100%, 54rem); margin: 0 auto; padding: clamp(2.5rem, 6vw, 4rem) var(--gutter) 5rem; }
  header { margin-bottom: 2rem; }
  .back { color: var(--fg-muted); font-size: .9rem; }
  h1 { margin: 1.5rem 0 1rem; font-size: clamp(1.9rem, 4.8vw, 3.25rem); line-height: 1.15; letter-spacing: -.045em; overflow-wrap: anywhere; }
  .meta { color: var(--fg-muted); font-size: .9rem; }
  .tags { display: flex; flex-wrap: wrap; gap: .5rem 1rem; padding: 0; margin: 1rem 0 0; list-style: none; color: var(--fg-muted); font-size: .85rem; }
  .cover { display: block; width: 100%; height: auto; border-radius: var(--radius); margin-bottom: 2.5rem; }
  .article-body { line-height: 1.85; overflow-wrap: anywhere; }
  .article-body :global(h2), .article-body :global(h3), .article-body :global(h4) { line-height: 1.3; letter-spacing: -.025em; margin: 2.4rem 0 1rem; }
  .article-body :global(p), .article-body :global(ul), .article-body :global(ol) { margin: 1rem 0; }
  .article-body :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: .2em; }
  .article-body :global(img) { display: block; max-width: 100%; height: auto; margin: 1.75rem auto; border-radius: .65rem; }
  .article-body :global(pre) { max-width: 100%; overflow-x: auto; padding: 1.2rem; background: var(--surface-2); border: 1px solid var(--line); border-radius: .65rem; font-size: .83rem; line-height: 1.65; }
  .article-body :global(code) { font-family: var(--font-mono); font-size: .88em; }
  .article-body :global(blockquote) { margin: 1.5rem 0; padding: .25rem 1rem; border-left: 3px solid var(--accent); color: var(--fg-muted); }
  .article-body :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; font-size: .9rem; }
  .article-body :global(th), .article-body :global(td) { border: 1px solid var(--line); padding: .65rem; }
  .article-body :global(hr) { border: 0; border-top: 1px solid var(--line); margin: 2rem 0; }
  footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem; margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  footer > a:last-child, .unavailable { color: var(--fg-muted); }
</style>
