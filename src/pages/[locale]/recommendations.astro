---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import { locales, type Locale } from '../../i18n/ui';
import { recommendationUi } from '../../i18n/recommendations';
import { getRecommendations } from '../../lib/recommendation-data';
import { linkHost, type PublicSection } from '../../lib/recommendations';
import { bookCoverUrl } from '../../lib/google-books';

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
const labels = recommendationUi[locale];
const { sections } = getRecommendations();
const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/recommendations-generated/*.png', { eager: true });
const preview = (section: PublicSection) => section.items.filter(item => item.data.googleBooksId || item.data.imageKey).slice(0, 4)
  .map(({ data }) => data.googleBooksId ? { src: bookCoverUrl(data.googleBooksId) }
    : { image: images[`../../assets/recommendations-generated/${data.imageKey}`]?.default });
const count = (section: PublicSection) => {
  const n = section.items.length;
  const [one, many] = section.kind === 'BOOKS' ? [labels.booksOne, labels.booksMany] : [labels.itemsOne, labels.itemsMany];
  return n === 1 ? one : many.replace('{n}', String(n));
};
---
<Base title={`${labels.title} - João Abreu`} description={labels.description}>
  <main id="main" class="page">
    <header class="page-head">
      <h1 data-split>{labels.title}</h1>
      <p data-reveal>{labels.description}</p>
    </header>
    {sections.length === 0 && <p class="muted">{labels.empty}</p>}
    <ul class="doors">
      {sections.map(section => {
        const external = section.kind === 'LINK';
        const covers = preview(section);
        return <li data-reveal>
          <a class="card door" href={external ? section.url : `/${locale}/recommendations/${section.slug}/`}
            {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
            {covers.length > 0 ? <span class="covers" aria-hidden="true">
              {covers.map(cover => cover.src ? <img src={cover.src} alt="" width="92" height="138" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                : cover.image && <Image src={cover.image} alt="" width={184} loading="lazy" decoding="async" />)}
            </span> : <span class="covers icon" aria-hidden="true"><svg viewBox="0 0 24 24">
              {external ? <path d="M6 7h12l-1 13H7L6 7Zm3 0V5a3 3 0 0 1 6 0v2" /> : <path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3Zm0 13a3 3 0 0 1 3-3h11" />}
            </svg></span>}
            <span class="door-copy">
              <strong class="door-title">{section[locale].title}</strong>
              {section[locale].description && <span class="door-description">{section[locale].description}</span>}
              <span class="door-meta">
                {external ? labels.external.replace('{host}', linkHost(section.url)) : count(section)}
                <span aria-hidden="true">{external ? ' ↗' : ' →'}</span>
              </span>
            </span>
          </a>
        </li>;
      })}
    </ul>
  </main>
</Base>
<style>
  .doors { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: 1.5rem; list-style: none; margin: 2rem 0 4rem; padding: 0; }
  .door { display: grid; gap: 1.25rem; align-content: start; height: 100%; padding: 1.5rem; color: inherit; text-decoration: none; transition: transform .2s var(--ease), border-color .2s; }
  .door:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--brand) 50%, var(--line)); }
  .door:focus-visible { outline: 2px solid var(--brand); outline-offset: 3px; }
  .covers { display: flex; gap: .6rem; height: 8.5rem; align-items: flex-end; }
  .covers :global(img) { height: 100%; width: auto; max-width: 25%; object-fit: contain; border-radius: .4rem; box-shadow: 0 8px 20px #0003; }
  .covers.icon { align-items: center; }
  .covers.icon svg { width: 4.5rem; height: 4.5rem; padding: 1rem; border: 1px solid var(--line); border-radius: 1rem; background: var(--surface);
    fill: none; stroke: var(--brand); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .door-copy { display: grid; gap: .45rem; }
  .door-title { font-size: clamp(1.4rem, 2.6vw, 1.8rem); }
  .door-description { color: var(--fg-muted); line-height: 1.6; }
  .door-meta { color: var(--brand); font-weight: 600; }
  @media (prefers-reduced-motion: reduce) { .door { transition: none; } .door:hover { transform: none; } }
</style>
