---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import { locales, type Locale } from '../../i18n/ui';
import { recommendationUi } from '../../i18n/recommendations';
import { getRecommendations } from '../../lib/recommendation-data';
import { recommendationCategories } from '../../lib/recommendations';
import { bookCoverUrl, bookInfoUrl } from '../../lib/google-books';

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
const labels = recommendationUi[locale];
const { recommendations } = getRecommendations();
const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/recommendations-generated/*.png', { eager: true });
const groups = recommendationCategories.map(category => ({ category,
  items: recommendations.filter(item => item.data.category === category),
})).filter(group => group.items.length > 0);
function imageFor(key: string) {
  const image = images[`../../assets/recommendations-generated/${key}`]?.default;
  if (!image) throw new Error(`Missing recommendation image: ${key}`);
  return image;
}
---
<Base title={`${labels.title} - João Abreu`} description={labels.description}>
  <main id="main" class="page">
    <header class="page-head">
      <h1 data-split>{labels.title}</h1>
      <p data-reveal>{labels.description}</p>
    </header>
    {groups.length === 0 && <p class="muted">{labels.empty}</p>}
    {groups.map(({ category, items }) => <section class="recommendation-group" aria-labelledby={`category-${category}`}>
      <h2 id={`category-${category}`}>{labels.categories[category]}</h2>
      <ul class="recommendations">
        {items.map(({ data }) => <li class="card recommendation" data-reveal>
          {data.googleBooksId ? <img src={bookCoverUrl(data.googleBooksId)} alt={data[locale].imageAlt} width="320" height="400" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
            : <Image src={imageFor(data.imageKey)} alt={data[locale].imageAlt} widths={[320, 640]}
              sizes="(max-width: 40rem) 100vw, 320px" width={640} loading="lazy" decoding="async" />}
          <div class="recommendation-copy">
            <h3>{data[locale].title}</h3>
            <p>{data[locale].description}</p>
            {data.url && <a href={data.url} target="_blank" rel="noopener noreferrer">{labels.open}<span class="sr-only">: {data[locale].title}</span> ↗</a>}
            {data.googleBooksId && <p><a href={bookInfoUrl(data.googleBooksId)} target="_blank" rel="noopener noreferrer">{labels.bookSource}</a><br />
              <img class="google-attribution" src="https://books.google.com/googlebooks/images/poweredby.png" alt={labels.poweredBy} width="62" height="30" loading="lazy" referrerpolicy="no-referrer" /></p>}
          </div>
        </li>)}
      </ul>
    </section>)}
  </main>
</Base>
<style>
  .recommendation-group { margin-block: 2.5rem; }
  .recommendations { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); gap: 1.25rem; list-style: none; padding: 0; }
  .recommendation { overflow: hidden; min-width: 0; }
  .recommendation img { display: block; width: 100%; height: 15rem; object-fit: contain; padding: 1rem; }
  .recommendation-copy { padding: 1.25rem; overflow-wrap: anywhere; }
  .recommendation-copy h3 { margin: 0 0 .75rem; }
  .recommendation-copy p { white-space: pre-line; line-height: 1.7; }
  .recommendation-copy a { display: inline-block; margin-top: .5rem; }
  .recommendation .google-attribution { width: 62px; height: 30px; padding: 0; object-fit: contain; }
</style>
