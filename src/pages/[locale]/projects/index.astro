---
// Projects list, modeled on developer.org.tr: compact cards (cover when there is one, name,
// GitHub link, one-line tagline, technologies, "View details" and the last push). The problem,
// decisions and result live on each project's own page.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../../../layouts/Base.astro';
import { localeTags, locales, useTranslations, type Locale } from '../../../i18n/ui';
import { getProjects } from '../../../lib/content';
import { getGitHubSnapshot } from '../../../lib/github';
import ProjectPopup from '../../../components/ProjectPopup.astro';

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
const projects = (await getProjects(locale)).filter((p) => p.role !== 'signal');
const covers = import.meta.glob<ImageMetadata>('../../../assets/case-studies/*', { eager: true, import: 'default' });
// Last push per repository, from the build snapshot; no date is shown when it is missing.
const snapshot = getGitHubSnapshot();
const pushed = new Map((snapshot?.repos ?? []).map((r) => [r.name, r.pushedAt]));
// Popup data: the repository card and its root folders and files (both from the snapshot).
const repos = new Map((snapshot?.repos ?? []).map((r) => [r.name, r]));
const trees = snapshot?.trees ?? null;
const popupLabels = {
	public: t('projects.public'),
	stars: t('projects.stars'),
	forks: t('projects.forks'),
	github: t('projects.repo'),
	viewGitHub: t('projects.viewGitHub'),
	back: t('projects.back'),
	moreFiles: t('projects.moreFiles'),
	files: t('projects.files'),
	folderError: t('projects.folderError'),
	close: t('projects.close'),
	openOnGitHub: t('projects.openOnGitHub'),
};
const monthYear = new Intl.DateTimeFormat(localeTags[locale], { month: 'short', year: 'numeric', timeZone: 'UTC' });
const repoName = (url: string) => url.split('/').pop() ?? '';
---

<Base title={`${t('nav.projects')} - João Abreu`} description={t('projectsPage.body')}>
	<main id="main" class="page">
		<header class="page-head">
			<h1 data-split>{t('nav.projects')}</h1>
			<p data-reveal>{t('projectsPage.body')}</p>
		</header>

		<ul class="grid projects">
			{
				projects.map((p, i) => {
					const cover = p.cover ? covers[`../../../assets/case-studies/${p.cover}`] : undefined;
					const last = pushed.get(repoName(p.repoUrl));
					const details = getRelativeLocaleUrl(locale, `projects/${p.id}/`);
					return (
						<li class="card project" data-reveal style={`--d: ${i * 100}ms`}>
							{cover && (
								<div class="cover">
									<Image src={cover} alt="" widths={[480, 720]} sizes="(min-width: 60rem) 22rem, 100vw" />
								</div>
							)}
							<div class="content">
								<div class="top">
									<svg class="folder" viewBox="0 0 24 24" aria-hidden="true">
										<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" />
									</svg>
									<h2>
										<a href={details} data-pop={p.id} aria-haspopup="dialog">
											{p.title}
										</a>
									</h2>
									<a class="gh" href={p.repoUrl} aria-label={`${t('projects.repo')}: ${p.title}`}>
										<svg viewBox="0 0 24 24" aria-hidden="true">
											<path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.4-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.4 1.1 3 .8.1-.6.4-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-5a3.9 3.9 0 0 1 1-2.7c-.1-.3-.5-1.3.1-2.7 0 0 .8-.3 2.8 1a9.6 9.6 0 0 1 5 0c1.9-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7a3.9 3.9 0 0 1 1 2.7c0 3.9-2.3 4.7-4.6 5 .4.3.7 1 .7 2v2.8c0 .3.2.6.7.5A10 10 0 0 0 12 2Z" />
										</svg>
									</a>
								</div>
								<p class="tagline muted">{p.tagline}</p>
								<ul class="tags" aria-label={t('projects.stack')}>
									{p.role === 'featured' && <li class="badge">{t('projects.featured')}</li>}
									{p.inProgress && (
										<li class="badge">
											<span class="dot" aria-hidden="true" />
											{t('projects.inProgress')}
										</li>
									)}
									{p.stack.map((s) => (
										<li class="chip">{s}</li>
									))}
								</ul>
								<p class="foot">
									<a class="details" href={details}>
										{t('projects.details')}
									</a>
									{last && (
										<span class="date">
											<svg viewBox="0 0 24 24" aria-hidden="true">
												<path d="M4 6h16v14H4Zm0 4h16M8 3v4m8-4v4" />
											</svg>
											<time datetime={last}>{monthYear.format(new Date(`${last.slice(0, 10)}T00:00:00Z`))}</time>
										</span>
									)}
								</p>
							</div>
						</li>
					);
				})
			}
		</ul>

		<!-- One popup per project with its GitHub card and root files (components/ProjectPopup.astro). -->
		{
			projects.map((p) => {
				const name = repoName(p.repoUrl);
				return (
					<ProjectPopup
						id={p.id}
						name={name}
						repoUrl={p.repoUrl}
						repo={repos.get(name)}
						tree={trees?.[name] ?? null}
						avatarUrl={snapshot?.profile?.avatarUrl ?? null}
						fallbackDescription={p.tagline}
						labels={popupLabels}
					/>
				);
			})
		}
	</main>
</Base>

<script>
	import '../../../scripts/card-glow';
</script>

<style>
	.projects {
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
		align-items: stretch;
		padding-bottom: 2rem;
	}

	.project {
		display: flex;
		flex-direction: column;
		padding: 0;
		overflow: hidden;
	}

	.cover {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-bottom: 1px solid var(--line);
	}

	.cover :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.content {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: 1.25rem 1.25rem 1rem;
	}

	.top {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.folder {
		flex-shrink: 0;
		width: 1.2rem;
		height: 1.2rem;
		fill: none;
		stroke: var(--fg);
		stroke-width: 1.75;
		stroke-linejoin: round;
	}

	h2 {
		flex: 1;
		min-width: 0;
		margin: 0;
		font-size: 1.1rem;
		letter-spacing: -0.015em;
		line-height: 1.3;
	}

	h2 a {
		color: var(--fg);
		text-decoration: none;
	}

	/* The whole card opens the project page; the GitHub icon stays its own link above it. */
	h2 a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.gh {
		position: relative;
		z-index: 1;
		display: grid;
		place-items: center;
		width: 1.9rem;
		height: 1.9rem;
		border-radius: 0.5rem;
		color: var(--fg-muted);
	}

	.gh:hover {
		background: var(--surface-2);
		color: var(--fg);
	}

	.gh svg {
		width: 1.1rem;
		height: 1.1rem;
		fill: currentColor;
	}

	.tagline {
		display: -webkit-box;
		margin: 0.75rem 0 1.25rem;
		overflow: hidden;
		font-size: 0.9rem;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0 0 1.25rem;
		padding: 0;
		list-style: none;
	}

	.chip {
		padding: 0.15rem 0.55rem;
		background: var(--surface-2);
		border: 1px solid var(--line);
		border-radius: 0.4rem;
		color: var(--fg-muted);
		font-size: 0.72rem;
		font-weight: 600;
	}

	.foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin: auto 0 0;
		padding-top: 0.9rem;
		border-top: 1px solid var(--line);
		font-size: 0.8rem;
	}

	.details {
		color: var(--brand);
		font-weight: 700;
	}

	.date {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--fg-muted);
	}

	.date svg {
		width: 0.95rem;
		height: 0.95rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.75;
		stroke-linecap: round;
	}

	.project:hover h2 a {
		color: var(--brand);
	}

	@media (prefers-reduced-motion: no-preference) {
		.project {
			transition:
				transform 0.25s var(--ease),
				border-color 0.2s;
		}

		.project:hover {
			border-color: var(--fg-muted);
			transform: translateY(-2px);
		}

		.cover :global(img) {
			transition: transform 0.5s var(--ease);
		}

		.project:hover .cover :global(img) {
			transform: scale(1.03);
		}
	}

	/* "View details" sits above the card-wide link, so it opens the page instead of the popup. */
	.details {
		position: relative;
		z-index: 1;
		text-decoration: none;
	}

	.details:hover {
		text-decoration: underline;
	}
</style>
