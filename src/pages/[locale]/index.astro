---
import Base from '../../layouts/Base.astro';
import { locales, useTranslations, type Locale } from '../../i18n/ui';
import { getContacts, getProjects, getResumePath, obfuscatedMailto } from '../../lib/content';

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);

// Content in the new layout; the full sections (radar contacts, activity, etc.) arrive in stage 8.
const projects = await getProjects(locale);
const workProjects = projects.filter((p) => p.role !== 'signal');
const signals = projects.filter((p) => p.role === 'signal');
const contacts = await getContacts();
const primaryContacts = contacts.filter((c) => c.primary);
const otherContacts = contacts.filter((c) => !c.primary);
const resumePath = getResumePath(locale);
---

<Base>
	<main id="main">
		<section class="hero">
			<p class="label" data-reveal>{t('home.status')}</p>
			<h1 data-split>{t('home.heading')}</h1>
			<p class="role" data-reveal style="--d: 250ms">{t('home.role')}</p>
			<p class="muted" data-reveal style="--d: 400ms">{t('home.body')}</p>
		</section>

		<section id="projects" aria-labelledby="projects-heading">
			<h2 id="projects-heading" class="label" data-reveal>{t('projects.heading')}</h2>
			{
				workProjects.map((p) => (
					<article class:list={['card', { featured: p.role === 'featured' }]} data-reveal data-project={p.id}>
						{p.role === 'featured' && <p class="label">{t('projects.featured')}</p>}
						<h3>{p.title}</h3>
						<p class="muted">{p.tagline}</p>
						<h4>{t('projects.problem')}</h4>
						<p>{p.problem}</p>
						<h4>{t('projects.decisions')}</h4>
						<ul>
							{p.decisions?.map((d) => (
								<li>{d}</li>
							))}
						</ul>
						<h4>{t('projects.result')}</h4>
						<p>{p.result}</p>
						<ul class="stack" aria-label={t('projects.stack')}>
							{p.stack.map((s) => (
								<li>{s}</li>
							))}
						</ul>
						<a class="repo" href={p.repoUrl}>
							{t('projects.repo')} ↗
						</a>
					</article>
				))
			}
		</section>

		<section id="signals" aria-labelledby="signals-heading">
			<h2 id="signals-heading" class="label" data-reveal>{t('signals.heading')}</h2>
			<ul class="signals">
				{
					signals.map((s, i) => (
						<li class="card" data-reveal style={`--d: ${i * 120}ms`}>
							<a href={s.repoUrl}>{s.title} ↗</a>
							<p class="muted">{s.tagline}</p>
						</li>
					))
				}
			</ul>
		</section>

		<section id="contact" aria-labelledby="contact-heading">
			<h2 id="contact-heading" class="label" data-reveal>{t('contact.heading')}</h2>
			<ul class="contacts primary" data-reveal>
				{
					primaryContacts.map((c) => (
						<li>
							{c.kind === 'email' ? <Fragment set:html={obfuscatedMailto(c.address)} /> : <a href={c.url}>{c.label}</a>}
						</li>
					))
				}
				{
					resumePath && (
						<li>
							<a href={resumePath}>{t('contact.resume')}</a>
						</li>
					)
				}
			</ul>
			<ul class="contacts secondary" data-reveal style="--d: 150ms">
				{
					otherContacts.map((c) => (
						<li>{c.kind !== 'email' && <a href={c.url}>{c.label}</a>}</li>
					))
				}
			</ul>
		</section>
	</main>
</Base>

<style>
	main {
		max-width: 46rem;
		padding: 0 1rem 5rem;
		overflow-wrap: anywhere;
	}

	section {
		padding-top: 3rem;
	}

	.hero {
		padding-block: 4rem 2rem;
	}

	.label {
		margin: 0 0 1rem;
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 400;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.25rem, 7vw, 3.75rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.1;
	}

	.role {
		margin: 0.75rem 0 0;
		font-size: 1.15rem;
	}

	.muted {
		color: var(--fg-muted);
	}

	.card {
		margin-block: 1.25rem;
		padding: 1.5rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 0.5rem;
	}

	.featured {
		border-color: var(--accent);
	}

	h3 {
		margin: 0;
		font-size: 1.35rem;
	}

	h4 {
		margin: 1.25rem 0 0.25rem;
		color: var(--fg-muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 400;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	h4 + p {
		margin-top: 0;
	}

	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1.25rem 0;
		padding: 0;
		list-style: none;
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}

	.stack li {
		padding: 0.15rem 0.5rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--fg-muted);
	}

	.repo {
		font-family: var(--font-mono);
		font-size: 0.85rem;
	}

	.signals {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.signals .muted {
		margin: 0.25rem 0 0;
	}

	.contacts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		margin: 0 0 1rem;
		padding: 0;
		list-style: none;
	}

	.contacts.primary {
		font-size: 1.1rem;
		font-weight: 600;
	}

	.contacts.secondary {
		font-family: var(--font-mono);
		font-size: 0.85rem;
	}

	@media (min-width: 60rem) {
		main {
			padding-inline: 2rem;
		}
	}
</style>
