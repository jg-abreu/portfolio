---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { createHash } from 'node:crypto';
import Base from '../../layouts/Base.astro';
import HeroContacts from '../../components/HeroContacts.astro';
import Heatmap from '../../components/Heatmap.astro';
import RepoGrid from '../../components/RepoGrid.astro';
import TechGrid from '../../components/TechGrid.astro';
import { localeTags, locales, useTranslations, type Locale } from '../../i18n/ui';
import { heatmapCells, recentRepos } from '../../lib/activity';
import { utcDate } from '../../lib/calendar';
import { getContacts, getProjects, getStack } from '../../lib/content';
import { getGitHubSnapshot } from '../../lib/github';
import { GITHUB_USER, practiceStats } from '../../lib/github-data';

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
const localeTag = localeTags[locale];
const numberFormat = new Intl.NumberFormat(localeTag);
const dateFormat = new Intl.DateTimeFormat(localeTag, { dateStyle: 'medium', timeZone: 'UTC' });

const projects = await getProjects(locale);
const practiceProject = projects.find((p) => p.id === 'leetcode');
const contacts = await getContacts();
const stackItems = (await getStack()).flatMap((g) => g.items);

// Build snapshot of GitHub data; the browser refreshes the contributions live.
const snapshot = getGitHubSnapshot();
const today = snapshot?.generatedAt ?? '';
const contributions = snapshot?.contributions ?? null;
const cells = contributions ? heatmapCells(contributions, today) : [];
const practiceDays = snapshot?.practiceDays ?? [];
// Practice days are UTC days, like LeetCode's, so the streak is measured against today in UTC.
const practice = practiceStats(practiceDays, utcDate());
const repos = snapshot?.repos ? recentRepos(snapshot.repos, 6) : [];
const descriptions = Object.fromEntries(projects.map((p) => [p.repo, p.tagline]));

const count = (key: Parameters<typeof t>[0], n: number) => t(key).replace('{n}', String(n));
const dayCount = (n: number) => (n === 1 ? t('leetcode.day') : count('leetcode.days', n));

// Structured data for search engines: who this page is about, with the public profiles.
const personJsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'João Abreu',
	url: new URL(getRelativeLocaleUrl(locale), Astro.site).href,
	jobTitle: t('home.role'),
	address: { '@type': 'PostalAddress', addressLocality: 'Rio de Janeiro', addressCountry: 'BR' },
	knowsAbout: stackItems,
	sameAs: contacts.filter((c) => c.kind !== 'email').map((c) => c.url),
}).replace(/</g, '\\u003c');

Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(personJsonLd).digest('base64')}`);
---

<Base>
	<script slot="head" type="application/ld+json" is:inline set:html={personJsonLd} />
	<main id="main" class="page">
		<!-- Clean entry: who, what, where to find me. The headline is the page's LCP element. -->
		<section class="hero">
			<p class="greeting" data-reveal>{t('home.greeting')}</p>
			<h1>{t('home.headline')}</h1>
			<p class="badges" data-reveal style="--d: 150ms">
				<span class="badge"><span class="dot" aria-hidden="true"></span>{t('home.status')}</span>
				<span class="badge">{t('home.location')}</span>
			</p>
			<div data-reveal style="--d: 250ms">
				<HeroContacts locale={locale} />
			</div>
		</section>

		<section class="band" aria-labelledby="contrib-heading">
			<div class="card contrib" data-reveal>
				<div class="card-head">
					<h2 id="contrib-heading">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h4l3-8 4 16 3-8h4"></path></svg>
						{t('home.contribTitle')}
					</h2>
					{
						contributions && (
							<p class="pill" data-live-block>
								<strong data-live="contributions" data-value={contributions.total}>
									{numberFormat.format(contributions.total)}
								</strong>{' '}
								{t('stats.contributions')}
							</p>
						)
					}
				</div>
				{
					contributions ? (
						<Heatmap
							cells={cells}
							today={today}
							localeTag={localeTag}
							labelOne={t('activity.cellOne')}
							labelMany={t('activity.cellMany')}
							summary={t('activity.summary')}
						>
							{t('activity.legend')}
						</Heatmap>
					) : (
						<p class="muted">{t('activity.noData')}</p>
					)
				}
			</div>
		</section>

		{
			practiceProject && practice && (
				<section class="band" aria-labelledby="practice-heading">
					<div class="card practice" data-reveal>
						<div class="card-head">
							<h2 id="practice-heading">
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="m8 7-5 5 5 5M16 7l5 5-5 5" />
								</svg>
								{t('home.practiceTitle')}
							</h2>
							<a class="btn btn-ghost" href={practiceProject.repoUrl}>
								{practiceProject.title} ↗
							</a>
						</div>
						<dl
							class="readings"
							data-practice={JSON.stringify(practiceDays)}
							data-day-one={t('leetcode.day')}
							data-day-many={t('leetcode.days')}
						>
							<div>
								<dt>{t('practice.activeDays')}</dt>
								<dd>
									<strong data-stat="practiceDays">{numberFormat.format(practice.activeDays)}</strong>
								</dd>
							</div>
							<div>
								<dt>{t('practice.currentStreak')}</dt>
								<dd>
									<strong data-stat="practiceCurrent">{dayCount(practice.currentStreak)}</strong>
								</dd>
							</div>
							<div>
								<dt>{t('practice.longestStreak')}</dt>
								<dd>
									<strong data-stat="practiceStreak">{dayCount(practice.longestStreak)}</strong>
								</dd>
							</div>
							<div>
								<dt>{t('practice.last')}</dt>
								<dd>
									<strong>
										<time data-stat="practiceLast" datetime={practice.lastDay}>
											{dateFormat.format(new Date(`${practice.lastDay}T00:00:00Z`))}
										</time>
									</strong>
								</dd>
							</div>
						</dl>
						<p class="note">{t('practice.note')}</p>
						{
							practiceProject.profiles && (
								<ul class="profiles" aria-label={t('practice.profiles')}>
									{practiceProject.profiles.map((p) => (
										<li>
											<a class="btn" href={p.url}>
												{p.label} ↗
											</a>
										</li>
									))}
								</ul>
							)
						}
					</div>
				</section>
			)
		}

		{
			repos.length > 0 && (
				<section class="band" aria-labelledby="repos-heading">
					<header class="band-head split-head" data-reveal>
						<div>
							<h2 id="repos-heading">
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="M9 21v-3c-4 1-4-2-6-2m12 5v-4c0-1-.3-1.5-1-2 3-.4 6-1.5 6-6a5 5 0 0 0-1-3c.2-1 .2-2-.2-3-1.4-.1-2.8.7-3.8 1.3a12 12 0 0 0-6 0C8 3.7 6.6 2.9 5.2 3c-.4 1-.4 2-.2 3a5 5 0 0 0-1 3c0 4.5 3 5.6 6 6-.7.5-1 1-1 2" />
								</svg>
								{t('home.reposTitle')}
							</h2>
							<p>{t('home.reposBody')}</p>
						</div>
						<a class="btn" href={`https://github.com/${GITHUB_USER}?tab=repositories`}>
							{t('home.reposAll')} ↗
						</a>
					</header>
					<div data-reveal>
						<RepoGrid
							repos={repos}
							descriptions={descriptions}
							localeTag={localeTag}
							pushedLabel={t('activity.pushed')}
							starsLabel={t('home.stars')}
						/>
					</div>
				</section>
			)
		}

		<section class="band" aria-labelledby="tech-heading">
			<header class="band-head" data-reveal>
				<h2 id="tech-heading">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4Z"></path></svg>
					{t('home.techTitle')}
				</h2>
				<p>{t('home.techBody')}</p>
			</header>
			<div data-reveal>
				<TechGrid items={stackItems} />
			</div>
		</section>
	</main>
</Base>

<script>
	import '../../scripts/github-live';
	import '../../scripts/card-glow';
</script>

<style>
	.hero {
		display: grid;
		align-content: center;
		min-height: min(70vh, 40rem);
		padding-block: 4rem 3rem;
	}

	.greeting {
		margin: 0 0 0.5rem;
		color: var(--fg-muted);
		font-size: clamp(1.1rem, 2.5vw, 1.35rem);
	}

	h1 {
		max-width: 16ch;
		margin: 0;
		font-size: clamp(2.6rem, 7.5vw, 4.25rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1.05;
	}

	.badges {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1.75rem 0 0;
	}

	.card-head,
	.split-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1rem;
	}

	.card-head {
		margin-bottom: 1.25rem;
	}

	.card-head h2 {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0;
		font-size: 1.1rem;
	}

	.card-head h2 svg {
		width: 1.15rem;
		height: 1.15rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.75;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.pill {
		margin: 0;
		padding: 0.2rem 0.75rem;
		background: var(--surface-2);
		border: 1px solid var(--line);
		border-radius: 0.5rem;
		color: var(--fg-muted);
		font-size: 0.8rem;
	}

	.pill strong {
		color: var(--fg);
	}

	.readings {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
		gap: 1rem;
		margin: 0;
	}

	.readings dt {
		color: var(--fg-muted);
		font-size: 0.8rem;
	}

	.readings dd {
		margin: 0.15rem 0 0;
	}

	.readings strong {
		font-size: 1.4rem;
		font-variant-numeric: tabular-nums;
		letter-spacing: -0.02em;
	}

	.note {
		margin: 1.25rem 0 0;
		color: var(--fg-muted);
		font-size: 0.85rem;
	}

	.profiles {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin: 1.25rem 0 0;
		padding: 0;
		list-style: none;
	}
</style>
