---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { createHash } from 'node:crypto';
import Base from '../../layouts/Base.astro';
import HeroContacts from '../../components/HeroContacts.astro';
import DeployPipeline from '../../components/DeployPipeline.astro';
import Heatmap from '../../components/Heatmap.astro';
import RadarScope from '../../components/RadarScope.astro';
import RecentRepos from '../../components/RecentRepos.astro';
import SonarDisplay from '../../components/SonarDisplay.astro';
import SonarIcon from '../../components/SonarIcon.astro';
import { localeTags, locales, useTranslations, type Locale, type UiKey } from '../../i18n/ui';
import { activityStats, heatmapCells, recentRepos } from '../../lib/activity';
import { getAbout, getContacts, getProjects, getStack } from '../../lib/content';
import { getGitHubSnapshot } from '../../lib/github';
import { LEETCODE_USER } from '../../lib/github-data';
import { toRadarContacts } from '../../lib/radar';

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);

// Each section after the hero has its own sonar display, numbered in page order.
const projects = await getProjects(locale);
const workProjects = projects.filter((p) => p.role !== 'signal');
const signals = projects.filter((p) => p.role === 'signal');
const radarContacts = toRadarContacts(workProjects);
const contacts = await getContacts();

// Build snapshot of GitHub and LeetCode data; the browser refreshes the GitHub parts live.
const snapshot = getGitHubSnapshot();
const numberFormat = new Intl.NumberFormat(localeTags[locale]);
const dateFormat = new Intl.DateTimeFormat(localeTags[locale], { dateStyle: 'medium', timeZone: 'UTC' });
const contributionsTotal = snapshot?.contributions?.total ?? null;
const publicRepos = snapshot?.profile?.publicRepos ?? null;
const leetcode = snapshot?.leetcode ?? null;
const localeTag = localeTags[locale];

const about = await getAbout(locale);
const stack = (await getStack()).map((g) => {
	const label = t(`stack.${g.id}` as UiKey);
	if (!label) throw new Error(`Missing UI string stack.${g.id} for the stack group in src/content/stack.yaml`);
	return { ...g, label };
});
const instrumentCount = stack.reduce((n, g) => n + g.items.length, 0);

// Activity: statistics and heatmap as of the snapshot day; the browser recomputes them live.
const today = snapshot?.generatedAt ?? '';
const contributions = snapshot?.contributions ?? null;
const stats = contributions ? activityStats(contributions, today) : null;
const cells = contributions ? heatmapCells(contributions, today) : [];
const recent = snapshot?.repos ? recentRepos(snapshot.repos, 8) : [];
// Repo descriptions in the page's language where the project has its own text.
const descriptions = Object.fromEntries(projects.map((p) => [p.repo, p.tagline]));

// Structured data for search engines: who this page is about, with the public profiles.
const personJsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'João Abreu',
	url: new URL(getRelativeLocaleUrl(locale), Astro.site).href,
	jobTitle: t('home.role'),
	address: { '@type': 'PostalAddress', addressLocality: 'Rio de Janeiro', addressCountry: 'BR' },
	knowsAbout: stack.flatMap((g) => g.items),
	sameAs: contacts.filter((c) => c.kind !== 'email').map((c) => c.url),
}).replace(/</g, '\\u003c');

Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(personJsonLd).digest('base64')}`);

// The real path a commit takes to the visitor (see deploy/README.md and .github/workflows/deploy.yml).
const pipelineStages = (['commit', 'build', 'ship', 'serve', 'edge', 'you'] as const).map((id) => ({
	id,
	name: t(`pipeline.${id}.name`),
	body: t(`pipeline.${id}.body`),
}));
// This page is rebuilt on every deploy, so the build date is the date of the last deploy.
const builtOn = dateFormat.format(new Date());

const SECTION_COUNT = 6;
const count = (key: Parameters<typeof t>[0], n: number) => t(key).replace('{n}', String(n));
const dayCount = (n: number) => (n === 1 ? t('leetcode.day') : count('leetcode.days', n));
const age = (days: number | null) =>
	days === null ? t('radar.noData') : days === 0 ? t('radar.today') : days === 1 ? t('radar.day') : count('radar.days', days);
---

<Base>
	<script slot="head" type="application/ld+json" is:inline set:html={personJsonLd} />
	<main id="main">
		<section class="hero">
			<div class="hero-text">
				<p class="label" data-reveal>{t('home.status')}</p>
				<h1 data-split>{t('home.heading')}</h1>
				<HeroContacts locale={locale} />
				<!-- Role and intro are visible from the first paint: the intro is the page's LCP element. -->
				<p class="role">{t('home.role')}</p>
				<p class="muted">{t('home.body')}</p>
				<ul class="stats" data-reveal style="--d: 300ms">
					<li data-live-block hidden={contributionsTotal === null}>
						<strong data-live="contributions" data-value={contributionsTotal ?? 0}>
							{contributionsTotal === null ? '' : numberFormat.format(contributionsTotal)}
						</strong>
						<span>{t('stats.contributions')}</span>
					</li>
					<li data-live-block hidden={publicRepos === null}>
						<strong data-live="repos" data-value={publicRepos ?? 0}>
							{publicRepos === null ? '' : numberFormat.format(publicRepos)}
						</strong>
						<span>{t('stats.repos')}</span>
					</li>
				</ul>
			</div>
			<div class="hero-scope" data-reveal style="--d: 200ms">
				<RadarScope />
				<p class="caption" aria-hidden="true">
					<span class="accent">{t('radar.active')}</span>
					<span>{t('panel.position')}</span>
					<span data-clock-line hidden>{t('clock.label')} <time data-clock></time></span>
				</p>
			</div>
		</section>

		{
			recent.length > 0 && (
				<RecentRepos
					variant="ticker"
					repos={recent}
					descriptions={descriptions}
					localeTag={localeTag}
					pushedLabel={t('activity.pushed')}
					pauseLabel={t('ticker.pause')}
					playLabel={t('ticker.play')}
				/>
			)
		}

		<section id="projects" class="split" aria-labelledby="projects-heading">
			<div class="aside">
				<SonarDisplay
					index={1}
					total={SECTION_COUNT}
					sectionWord={t('display.section')}
					label={t('nav.projects')}
					detail={count('display.projects', radarContacts.length)}
				>
					<RadarScope contacts={radarContacts} />
					<Fragment slot="readout">
						<ol
							class="contacts"
							aria-hidden="true"
							data-age-today={t('radar.today')}
							data-age-day={t('radar.day')}
							data-age-days={t('radar.days')}
						>
							{
								radarContacts.map((c) => (
									<li data-contact={c.id} data-repo={c.repo}>
										<span class="title">
											<span class="num">{c.number}</span> {c.title}
										</span>
										<span class="age">{age(c.days)}</span>
									</li>
								))
							}
						</ol>
						<p class="meta">{t('radar.legend')}</p>
						<p class="meta hint">{t('radar.hint')}</p>
					</Fragment>
				</SonarDisplay>
			</div>
			<div class="body">
				<p class="label" data-reveal>01 · {t('projects.heading')}</p>
				<h2 id="projects-heading" data-split>{t('projects.title')}</h2>
				{
					workProjects.map((p) => (
						<article class:list={['card', { featured: p.role === 'featured' }]} data-reveal data-project={p.id}>
							{p.role === 'featured' && <p class="label">{t('projects.featured')}</p>}
							<h3>{p.title}</h3>
							<p class="muted">{p.tagline}</p>
							<h4>{t('projects.problem')}</h4>
							<p>{p.problem}</p>
							<h4>{t('projects.decisions')}</h4>
							<ul>
								{p.decisions?.map((d) => (
									<li>{d}</li>
								))}
							</ul>
							<h4>{t('projects.result')}</h4>
							<p>{p.result}</p>
							<ul class="stack" aria-label={t('projects.stack')}>
								{p.stack.map((s) => (
									<li>{s}</li>
								))}
							</ul>
							<p class="card-links">
								{p.caseStudy && (
									<a class="btn btn-primary" href={getRelativeLocaleUrl(locale, `projects/${p.id}/`)}>
										{t('caseStudy.read')} →
									</a>
								)}
								<a class="btn" href={p.repoUrl}>
									{t('projects.repo')} ↗
								</a>
							</p>
						</article>
					))
				}
			</div>
		</section>

		<section id="about" class="split" aria-labelledby="about-heading">
			<div class="aside">
				<SonarDisplay
					index={2}
					total={SECTION_COUNT}
					sectionWord={t('display.section')}
					label={t('nav.about')}
					detail={t('display.about')}
				>
					<SonarIcon name="anchor" />
				</SonarDisplay>
			</div>
			<div class="body">
				<p class="label" data-reveal>02 · {t('about.heading')}</p>
				<h2 id="about-heading" data-split>{t('about.title')}</h2>
				{
					about.paragraphs.map((p) => (
						<p class="lead" data-reveal>
							{p}
						</p>
					))
				}
				<div class="card now" data-reveal>
					<h3 class="label">{t('about.now')}</h3>
					<ul>
						{about.now.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			</div>
		</section>

		<section id="stack" class="split" aria-labelledby="stack-heading">
			<div class="aside">
				<SonarDisplay
					index={3}
					total={SECTION_COUNT}
					sectionWord={t('display.section')}
					label={t('nav.stack')}
					detail={count('display.stack', instrumentCount)}
				>
					<SonarIcon name="bars" />
				</SonarDisplay>
			</div>
			<div class="body">
				<p class="label" data-reveal>03 · {t('stack.heading')}</p>
				<h2 id="stack-heading" data-split>{t('stack.title')}</h2>
				<div class="stack-groups">
					{
						stack.map((g, i) => (
							<div class="card" data-reveal style={`--d: ${(i % 2) * 120}ms`}>
								<h3>{g.label}</h3>
								<ul class="stack">
									{g.items.map((item) => (
										<li>{item}</li>
									))}
								</ul>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section id="activity" class="split" aria-labelledby="activity-heading">
			<div class="aside">
				<SonarDisplay
					index={4}
					total={SECTION_COUNT}
					sectionWord={t('display.section')}
					label={t('nav.activity')}
					detail={stats ? count('display.activity', stats.activeDays) : t('radar.noData')}
				>
					<SonarIcon name="pulse" />
				</SonarDisplay>
			</div>
			<div class="body">
				<p class="label" data-reveal>04 · {t('activity.heading')}</p>
				<h2 id="activity-heading" data-split>{t('activity.title')}</h2>
				{
					stats ? (
						<>
							<dl
								class="readings activity-stats"
								data-reveal
								data-activity-stats
								data-day-one={t('leetcode.day')}
								data-day-many={t('leetcode.days')}
							>
								<div>
									<dt>{t('activity.total')}</dt>
									<dd>
										<strong data-stat="total">{numberFormat.format(stats.total)}</strong>
									</dd>
								</div>
								<div>
									<dt>{t('activity.activeDays')}</dt>
									<dd>
										<strong data-stat="activeDays">{numberFormat.format(stats.activeDays)}</strong>
									</dd>
								</div>
								<div>
									<dt>{t('activity.currentStreak')}</dt>
									<dd>
										<strong data-stat="currentStreak">{dayCount(stats.currentStreak)}</strong>
									</dd>
								</div>
								<div>
									<dt>{t('activity.longestStreak')}</dt>
									<dd>
										<strong data-stat="longestStreak">{dayCount(stats.longestStreak)}</strong>
									</dd>
								</div>
								{stats.bestDay && (
									<div>
										<dt>{t('activity.bestDay')}</dt>
										<dd>
											<strong data-stat="bestCount">{numberFormat.format(stats.bestDay.count)}</strong>
											<span data-stat="bestDate">
												{dateFormat.format(new Date(`${stats.bestDay.date}T00:00:00Z`))}
											</span>
										</dd>
									</div>
								)}
							</dl>
							<div class="card heat-card" data-reveal>
								<Heatmap
									cells={cells}
									today={today}
									localeTag={localeTag}
									labelOne={t('activity.cellOne')}
									labelMany={t('activity.cellMany')}
									summary={t('activity.summary')}
								>
									{t('activity.legend')}
								</Heatmap>
							</div>
						</>
					) : (
						<p class="muted">{t('activity.noData')}</p>
					)
				}
				{
					recent.length > 0 && (
						<>
							<h3 class="label recent-title" data-reveal>
								{t('activity.recent')}
							</h3>
							<div data-reveal>
								<RecentRepos
									variant="cards"
									repos={recent.slice(0, 4)}
									descriptions={descriptions}
									localeTag={localeTag}
									pushedLabel={t('activity.pushed')}
								/>
							</div>
						</>
					)
				}
			</div>
		</section>

		<section id="signals" class="split" aria-labelledby="signals-heading">
			<div class="aside">
				<SonarDisplay
					index={5}
					total={SECTION_COUNT}
					sectionWord={t('display.section')}
					label={t('nav.signals')}
					detail={count('display.signals', signals.length)}
				>
					<SonarIcon name="dial" />
				</SonarDisplay>
			</div>
			<div class="body">
				<p class="label" data-reveal>05 · {t('signals.heading')}</p>
				<h2 id="signals-heading" data-split>{t('signals.title')}</h2>
				<ul class="signals">
					{
						signals.map((s, i) => (
							<li class="card" data-reveal style={`--d: ${i * 120}ms`}>
								<a href={s.repoUrl}>{s.title} ↗</a>
								<p class="muted">{s.tagline}</p>
								{s.id === 'leetcode' && leetcode && (
									<>
										<dl class="readings">
											<div>
												<dt>{t('leetcode.solved')}</dt>
												<dd>
													<strong>{numberFormat.format(leetcode.solved)}</strong>
													<span>
														{t('leetcode.breakdown')
															.replace('{e}', numberFormat.format(leetcode.easy))
															.replace('{m}', numberFormat.format(leetcode.medium))
															.replace('{h}', numberFormat.format(leetcode.hard))}
													</span>
												</dd>
											</div>
											<div>
												<dt>{t('leetcode.activeDays')}</dt>
												<dd>
													<strong>{numberFormat.format(leetcode.activeDays)}</strong>
												</dd>
											</div>
											<div>
												<dt>{t('leetcode.maxStreak')}</dt>
												<dd>
													<strong>{dayCount(leetcode.maxStreak)}</strong>
												</dd>
											</div>
											{leetcode.lastSubmission && (
												<div>
													<dt>{t('leetcode.last')}</dt>
													<dd>
														<strong>
															<time datetime={leetcode.lastSubmission}>
																{dateFormat.format(new Date(`${leetcode.lastSubmission}T00:00:00Z`))}
															</time>
														</strong>
													</dd>
												</div>
											)}
										</dl>
										<p class="note">
											<a href={`https://leetcode.com/u/${LEETCODE_USER}/`}>{t('leetcode.profile')} ↗</a>
											<span>{t('leetcode.updated')}</span>
										</p>
									</>
								)}
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section id="pipeline" class="split" aria-labelledby="pipeline-heading">
			<div class="aside">
				<SonarDisplay
					index={6}
					total={SECTION_COUNT}
					sectionWord={t('display.section')}
					label={t('nav.pipeline')}
					detail={count('display.pipeline', pipelineStages.length).replace('{date}', builtOn)}
				>
					<SonarIcon name="route" />
				</SonarDisplay>
			</div>
			<div class="body">
				<p class="label" data-reveal>06 · {t('pipeline.heading')}</p>
				<h2 id="pipeline-heading" data-split>{t('pipeline.title')}</h2>
				<div data-reveal>
					<DeployPipeline stages={pipelineStages} />
				</div>
				<div class="card pipeline-note" data-reveal style="--d: 150ms">
					<p>{t('pipeline.when')}</p>
					<p class="card-links">
						<a class="btn" href="https://github.com/jg-abreu/portfolio/blob/main/.github/workflows/deploy.yml">
							{t('pipeline.workflow')} ↗
						</a>
						<a class="btn" href="https://github.com/jg-abreu/portfolio/blob/main/deploy/README.md">
							{t('pipeline.server')} ↗
						</a>
					</p>
				</div>
			</div>
		</section>


	</main>
</Base>

<script>
	import '../../scripts/github-live';
	import '../../scripts/card-glow';
</script>

<style>
	main {
		max-width: var(--page-width);
		margin: 0 auto;
		padding: 0 var(--gutter) 6rem;
		overflow-wrap: anywhere;
	}

	/* Hero: text and a live scope side by side on wide screens. */
	.hero {
		display: grid;
		align-items: center;
		gap: 2.5rem;
		padding-block: 4rem 3rem;
	}

	.hero-scope {
		width: min(100%, 22rem);
		justify-self: center;
	}

	.caption {
		display: grid;
		gap: 0.25rem;
		margin: 1rem 0 0;
		color: var(--fg-muted);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.15em;
		text-align: center;
	}

	.accent {
		color: var(--accent);
	}

	/* Section: sticky sonar display on the left that leaves with its section, content on the right. */
	/* minmax(0, …): wide content (the year heatmap) scrolls inside its card instead of widening the page. */
	.split {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 2rem;
		padding-block: 5rem;
		/* The browser skips style and layout for sections far from the screen (hundreds of SVG dots
		   and heatmap cells) until they approach; `auto` remembers each section's real height. */
		content-visibility: auto;
		contain-intrinsic-size: auto 60rem;
	}

	.aside {
		width: min(100%, 22rem);
		justify-self: center;
	}

	.label {
		margin: 0 0 1rem;
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 400;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	h1,
	h2 {
		margin: 0;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.1;
	}

	h1 {
		font-size: clamp(2.5rem, 8vw, 4.5rem);
	}

	h2 {
		margin-bottom: 2rem;
		font-size: clamp(2rem, 5vw, 3rem);
	}

	.role {
		margin: 1rem 0 0;
		font-size: 1.2rem;
	}

	.muted {
		color: var(--fg-muted);
	}

	.card {
		position: relative;
		isolation: isolate;
		margin-block: 1.25rem;
		padding: 1.5rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 0.75rem;
	}

	.card :global(.card-glow) {
		display: none;
		position: absolute;
		inset: 0 auto auto 0;
		width: 320px;
		height: 320px;
		z-index: -1;
		pointer-events: none;
		opacity: 0;
		background: radial-gradient(circle, rgb(111 140 255 / 12%), transparent 70%);
	}

	@media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
		.card {
			overflow: clip;
		}
		.card :global(.card-glow) {
			display: block;
			transition: opacity 180ms ease;
		}
		.card :global(.card-glow.is-active) {
			opacity: 1;
		}
	}

	.featured {
		border-color: var(--accent);
	}

	h3 {
		margin: 0;
		font-size: 1.35rem;
	}

	h4 {
		margin: 1.25rem 0 0.25rem;
		color: var(--fg-muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 400;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	h4 + p {
		margin-top: 0;
	}

	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1.25rem 0;
		padding: 0;
		list-style: none;
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}

	.stack li {
		padding: 0.15rem 0.5rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--fg-muted);
	}

	.card-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 0;
	}

	.signals {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.signals .muted {
		margin: 0.25rem 0 0;
	}

	.lead {
		margin: 0 0 1.25rem;
		font-size: 1.1rem;
		line-height: 1.7;
	}

	.now ul {
		display: grid;
		gap: 0.5rem;
		margin: 0;
		padding-left: 1.1rem;
	}

	.now li::marker {
		color: var(--accent);
	}

	.stack-groups {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 1rem;
	}

	.stack-groups .card {
		margin: 0;
