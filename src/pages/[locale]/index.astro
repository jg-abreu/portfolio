---
import Base from '../../layouts/Base.astro';
import RadarScope from '../../components/RadarScope.astro';
import SonarDisplay from '../../components/SonarDisplay.astro';
import SonarIcon from '../../components/SonarIcon.astro';
import { localeTags, locales, useTranslations, type Locale } from '../../i18n/ui';
import { getContacts, getProjects, getResumePath, obfuscatedMailto } from '../../lib/content';
import { getGitHubSnapshot } from '../../lib/github';
import { LEETCODE_USER } from '../../lib/github-data';
import { toRadarContacts } from '../../lib/radar';

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);

// Full sections (about, stack, activity) arrive in stage 8; each gets its own sonar display.
const projects = await getProjects(locale);
const workProjects = projects.filter((p) => p.role !== 'signal');
const signals = projects.filter((p) => p.role === 'signal');
const radarContacts = toRadarContacts(workProjects);
const contacts = await getContacts();
const primaryContacts = contacts.filter((c) => c.primary);
const otherContacts = contacts.filter((c) => !c.primary);
const resumePath = getResumePath(locale);
const channelCount = contacts.length + (resumePath ? 1 : 0);

// Build snapshot of GitHub and LeetCode data; the browser refreshes the GitHub parts live.
const snapshot = getGitHubSnapshot();
const numberFormat = new Intl.NumberFormat(localeTags[locale]);
const dateFormat = new Intl.DateTimeFormat(localeTags[locale], { dateStyle: 'medium', timeZone: 'UTC' });
const contributionsTotal = snapshot?.contributions?.total ?? null;
const publicRepos = snapshot?.profile?.publicRepos ?? null;
const leetcode = snapshot?.leetcode ?? null;

const SECTION_COUNT = 3;
const count = (key: Parameters<typeof t>[0], n: number) => t(key).replace('{n}', String(n));
const dayCount = (n: number) => (n === 1 ? t('leetcode.day') : count('leetcode.days', n));
const age = (days: number | null) =>
	days === null ? t('radar.noData') : days === 0 ? t('radar.today') : days === 1 ? t('radar.day') : count('radar.days', days);
---

<Base>
	<main id="main">
		<section class="hero">
			<div class="hero-text">
				<p class="label" data-reveal>{t('home.status')}</p>
				<h1 data-split>{t('home.heading')}</h1>
				<!-- Role and intro are visible from the first paint: the intro is the page's LCP element. -->
				<p class="role">{t('home.role')}</p>
				<p class="muted">{t('home.body')}</p>
				<ul class="stats" data-reveal style="--d: 300ms">
					<li data-live-block hidden={contributionsTotal === null}>
						<strong data-live="contributions" data-value={contributionsTotal ?? 0}>
							{contributionsTotal === null ? '' : numberFormat.format(contributionsTotal)}
						</strong>
						<span>{t('stats.contributions')}</span>
					</li>
					<li data-live-block hidden={publicRepos === null}>
						<strong data-live="repos" data-value={publicRepos ?? 0}>
							{publicRepos === null ? '' : numberFormat.format(publicRepos)}
						</strong>
						<span>{t('stats.repos')}</span>
					</li>
				</ul>
			</div>
			<div class="hero-scope" data-reveal style="--d: 200ms">
				<RadarScope />
				<p class="caption" aria-hidden="true">
					<span class="accent">{t('radar.active')}</span>
					<span>{t('panel.position')}</span>
				</p>
			</div>
		</section>

		<section id="projects" class="split" aria-labelledby="projects-heading">
			<div class="aside">
				<SonarDisplay
					index={1}
					total={SECTION_COUNT}
					sectionWord={t('display.section')}
					label={t('nav.projects')}
					detail={count('display.projects', radarContacts.length)}
				>
					<RadarScope contacts={radarContacts} />
					<Fragment slot="readout">
						<ol
							class="contacts"
							aria-hidden="true"
							data-age-today={t('radar.today')}
							data-age-day={t('radar.day')}
							data-age-days={t('radar.days')}
						>
							{
								radarContacts.map((c) => (
									<li data-contact={c.id} data-repo={c.repo}>
										<span class="title">
											<span class="num">{c.number}</span> {c.title}
										</span>
										<span class="age">{age(c.days)}</span>
									</li>
								))
							}
						</ol>
						<p class="meta">{t('radar.legend')}</p>
						<p class="meta hint">{t('radar.hint')}</p>
					</Fragment>
				</SonarDisplay>
			</div>
			<div class="body">
				<p class="label" data-reveal>01 · {t('projects.heading')}</p>
				<h2 id="projects-heading" data-split>{t('projects.title')}</h2>
				{
					workProjects.map((p) => (
						<article class:list={['card', { featured: p.role === 'featured' }]} data-reveal data-project={p.id}>
							{p.role === 'featured' && <p class="label">{t('projects.featured')}</p>}
							<h3>{p.title}</h3>
							<p class="muted">{p.tagline}</p>
							<h4>{t('projects.problem')}</h4>
							<p>{p.problem}</p>
							<h4>{t('projects.decisions')}</h4>
							<ul>
								{p.decisions?.map((d) => (
									<li>{d}</li>
								))}
							</ul>
							<h4>{t('projects.result')}</h4>
							<p>{p.result}</p>
							<ul class="stack" aria-label={t('projects.stack')}>
								{p.stack.map((s) => (
									<li>{s}</li>
								))}
							</ul>
							<a class="repo" href={p.repoUrl}>
								{t('projects.repo')} ↗
							</a>
						</article>
					))
				}
			</div>
		</section>

		<section id="signals" class="split" aria-labelledby="signals-heading">
			<div class="aside">
				<SonarDisplay
					index={2}
					total={SECTION_COUNT}
					sectionWord={t('display.section')}
					label={t('nav.signals')}
					detail={count('display.signals', signals.length)}
				>
					<SonarIcon name="dial" />
				</SonarDisplay>
			</div>
			<div class="body">
				<p class="label" data-reveal>02 · {t('signals.heading')}</p>
				<h2 id="signals-heading" data-split>{t('signals.title')}</h2>
				<ul class="signals">
					{
						signals.map((s, i) => (
							<li class="card" data-reveal style={`--d: ${i * 120}ms`}>
								<a href={s.repoUrl}>{s.title} ↗</a>
								<p class="muted">{s.tagline}</p>
								{s.id === 'leetcode' && leetcode && (
									<>
										<dl class="readings">
											<div>
												<dt>{t('leetcode.solved')}</dt>
												<dd>
													<strong>{numberFormat.format(leetcode.solved)}</strong>
													<span>
														{t('leetcode.breakdown')
															.replace('{e}', numberFormat.format(leetcode.easy))
															.replace('{m}', numberFormat.format(leetcode.medium))
															.replace('{h}', numberFormat.format(leetcode.hard))}
													</span>
												</dd>
											</div>
											<div>
												<dt>{t('leetcode.activeDays')}</dt>
												<dd>
													<strong>{numberFormat.format(leetcode.activeDays)}</strong>
												</dd>
											</div>
											<div>
												<dt>{t('leetcode.maxStreak')}</dt>
												<dd>
													<strong>{dayCount(leetcode.maxStreak)}</strong>
												</dd>
											</div>
											{leetcode.lastSubmission && (
												<div>
													<dt>{t('leetcode.last')}</dt>
													<dd>
														<strong>
															<time datetime={leetcode.lastSubmission}>
																{dateFormat.format(new Date(`${leetcode.lastSubmission}T00:00:00Z`))}
															</time>
														</strong>
													</dd>
												</div>
											)}
										</dl>
										<p class="note">
											<a href={`https://leetcode.com/u/${LEETCODE_USER}/`}>{t('leetcode.profile')} ↗</a>
											<span>{t('leetcode.updated')}</span>
										</p>
									</>
								)}
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section id="contact" class="split" aria-labelledby="contact-heading">
			<div class="aside">
				<SonarDisplay
					index={3}
					total={SECTION_COUNT}
					sectionWord={t('display.section')}
					label={t('nav.contact')}
					detail={count('display.contact', channelCount)}
				>
					<SonarIcon name="antenna" />
				</SonarDisplay>
			</div>
			<div class="body">
				<p class="label" data-reveal>03 · {t('contact.heading')}</p>
				<h2 id="contact-heading" data-split>{t('contact.title')}</h2>
				<ul class="contact-list primary" data-reveal>
					{
						primaryContacts.map((c) => (
							<li>
								{c.kind === 'email' ? <Fragment set:html={obfuscatedMailto(c.address)} /> : <a href={c.url}>{c.label}</a>}
							</li>
						))
					}
					{
						resumePath && (
							<li>
								<a href={resumePath}>{t('contact.resume')}</a>
							</li>
						)
					}
				</ul>
				<ul class="contact-list secondary" data-reveal style="--d: 150ms">
					{
						otherContacts.map((c) => (
							<li>{c.kind !== 'email' && <a href={c.url}>{c.label}</a>}</li>
						))
					}
				</ul>
			</div>
		</section>
	</main>
</Base>

<script>
	import '../../scripts/github-live';
</script>

<style>
	main {
		max-width: var(--page-width);
		margin: 0 auto;
		padding: 0 var(--gutter) 6rem;
		overflow-wrap: anywhere;
	}

	/* Hero: text and a live scope side by side on wide screens. */
	.hero {
		display: grid;
		align-items: center;
		gap: 2.5rem;
		padding-block: 4rem 3rem;
	}

	.hero-scope {
		width: min(100%, 22rem);
		justify-self: center;
	}

	.caption {
		display: grid;
		gap: 0.25rem;
		margin: 1rem 0 0;
		color: var(--fg-muted);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.15em;
		text-align: center;
	}

	.accent {
		color: var(--accent);
	}

	/* Section: sticky sonar display on the left that leaves with its section, content on the right. */
	.split {
		display: grid;
		gap: 2rem;
		padding-block: 5rem;
	}

	.aside {
		width: min(100%, 22rem);
		justify-self: center;
	}

	.label {
		margin: 0 0 1rem;
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 400;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	h1,
	h2 {
		margin: 0;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.1;
	}

	h1 {
		font-size: clamp(2.5rem, 8vw, 4.5rem);
	}

	h2 {
		margin-bottom: 2rem;
		font-size: clamp(2rem, 5vw, 3rem);
	}

	.role {
		margin: 1rem 0 0;
		font-size: 1.2rem;
	}

	.muted {
		color: var(--fg-muted);
	}

	.card {
		margin-block: 1.25rem;
		padding: 1.5rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 0.75rem;
	}

	.featured {
		border-color: var(--accent);
	}

	h3 {
		margin: 0;
		font-size: 1.35rem;
	}

	h4 {
		margin: 1.25rem 0 0.25rem;
		color: var(--fg-muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 400;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	h4 + p {
		margin-top: 0;
	}

	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1.25rem 0;
		padding: 0;
		list-style: none;
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}

	.stack li {
		padding: 0.15rem 0.5rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--fg-muted);
	}

	.repo {
		font-family: var(--font-mono);
		font-size: 0.85rem;
	}

	.signals {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.signals .muted {
		margin: 0.25rem 0 0;
	}

	/* Hero counters: real numbers from the snapshot, refreshed live. */
	.stats {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2.5rem;
		margin: 2rem 0 0;
		padding: 0;
		list-style: none;
	}

	.stats li {
		display: grid;
	}

	.stats li[hidden] {
		display: none;
	}

	.stats strong {
		color: var(--fg);
		font-size: clamp(1.75rem, 4vw, 2.25rem);
		font-variant-numeric: tabular-nums;
		line-height: 1.1;
	}

	.stats span {
		color: var(--fg-muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
	}

	/* LeetCode readings inside the consistency card. */
	.readings {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr));
		gap: 1rem;
		margin: 1.25rem 0 0;
	}

	.readings dt {
		color: var(--fg-muted);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.readings dd {
		display: grid;
		margin: 0.2rem 0 0;
	}

	.readings strong {
		font-size: 1.25rem;
		font-variant-numeric: tabular-nums;
	}

	.readings span,
	.note span {
		color: var(--fg-muted);
		font-size: 0.85rem;
	}

	.note {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		margin: 1.25rem 0 0;
		font-family: var(--font-mono);
		font-size: 0.8rem;
	}

	.contact-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		margin: 0 0 1.25rem;
		padding: 0;
		list-style: none;
	}

	.contact-list.primary {
		font-size: 1.15rem;
		font-weight: 600;
	}

	.contact-list.secondary {
		font-family: var(--font-mono);
		font-size: 0.85rem;
	}

	/* Radar readout inside the projects display. */
	.contacts {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.35rem;
		letter-spacing: 0.02em;
		margin: 0.25rem 0 0;
		padding: 0;
		list-style: none;
		color: var(--fg-muted);
	}

	/* One line per contact: number and name on the left, time since the last push on the right. */
	.contacts li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-left: 0.75rem;
		border-left: 1px solid var(--line);
		white-space: nowrap;
	}

	.contacts .title {
		min-width: 0;
		overflow: hidden;
		color: var(--fg);
		text-overflow: ellipsis;
		text-transform: uppercase;
	}

	.contacts .num,
	.contacts .age {
		color: var(--fg-muted);
	}

	.contacts .age {
		flex-shrink: 0;
	}

	.contacts li:global(.is-focus) {
		border-left-color: var(--accent);
	}

	.contacts li:global(.is-focus) .num,
	.contacts li:global(.is-focus) .age {
		color: var(--accent);
	}

	.meta {
		color: var(--fg-muted);
	}

	@media (prefers-reduced-motion: reduce) {
		.hint {
			display: none;
		}
	}

	/* Phones: a smaller display above the section, without the contact list (the cards follow). */
	@media (max-width: 59.99rem) {
		.aside {
			width: min(100%, 17rem);
		}

		.contacts,
		.meta {
			display: none;
		}
	}

	@media (min-width: 60rem) {
		.hero {
			grid-template-columns: 3fr 2fr;
			min-height: calc(100vh - var(--header-height));
			padding-block: 2rem;
		}

		.hero-scope {
			width: min(100%, 26rem);
		}

		.split {
			grid-template-columns: minmax(18rem, 5fr) 7fr;
			gap: 4rem;
			align-items: start;
		}

		.aside {
			width: 100%;
			max-width: 25rem;
		}

		/* The screen's drawing shrinks on shorter screens so the whole display fits while sticky;
		   the readout keeps the full column width so project names stay readable. */
		.aside :global([data-scope]),
		.aside :global(.icon) {
			max-width: clamp(12rem, calc(100vh - 28rem), 100%);
			margin-inline: auto;
		}
	}

	/* Only stick when the display fits on screen; otherwise it simply scrolls with its section. */
	@media (min-width: 60rem) and (min-height: 43rem) {
		.aside {
			position: sticky;
			top: calc(var(--header-height) + 1.5rem);
		}
	}
</style>
