---
// "How this site reaches you": the site's own delivery path, told as a journey the visitor scrolls
// through. Build facts (commit, run) are read at build time; the visit's own facts (timings,
// headers, Cloudflare data center, latest deploy) are measured live by scripts/journey.ts.
// Nothing is invented: a value that cannot be read stays hidden or says where it shows up.
import { execFileSync } from 'node:child_process';
import Base from '../../layouts/Base.astro';
import Handoff from '../../components/Handoff.astro';
import { localeTags, locales, useTranslations, type Locale } from '../../i18n/ui';
import { GITHUB_USER } from '../../lib/github-data';

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
const localeTag = localeTags[locale];
const repoUrl = `https://github.com/${GITHUB_USER}/portfolio`;
const workflowUrl = `${repoUrl}/blob/main/.github/workflows/deploy.yml`;
const serverUrl = `${repoUrl}/blob/main/deploy/README.md`;

// The commit being built: in GitHub Actions the checkout is exactly the deployed commit.
function lastCommit() {
	try {
		const out = execFileSync('git', ['log', '-1', '--format=%H%x1f%s%x1f%cI'], { encoding: 'utf8' }).trim();
		const [sha = '', subject = '', date = ''] = out.split('\x1f');
		if (!/^[0-9a-f]{40}$/.test(sha) || Number.isNaN(Date.parse(date))) return null;
		return { sha, short: sha.slice(0, 7), subject, date };
	} catch {
		return null;
	}
}
const commit = lastCommit();
// Set by GitHub Actions; absent on a local build.
const runId = /^\d+$/.test(process.env.GITHUB_RUN_ID ?? '') ? process.env.GITHUB_RUN_ID : null;
const runUrl = runId ? `${repoUrl}/actions/runs/${runId}` : null;
const builtAt = new Date();
const dateTime = new Intl.DateTimeFormat(localeTag, {
	dateStyle: 'medium',
	timeStyle: 'short',
	timeZone: 'America/Sao_Paulo',
});

const total = 6;
const stageLabel = (n: number) => t('journey.stage').replace('{n}', String(n)).replace('{total}', String(total));
const ids = ['commit', 'build', 'ship', 'serve', 'edge', 'you'] as const;
const names = ids.map((id) => t(`pipeline.${id}.name`));
// What each stage delivers; the next stage opens by repeating it, so the page reads as one thread.
const delivered = (i: number) =>
	i === 0 ? t('journey.commit.out').replace('{sha}', commit?.short ?? 'HEAD') : t(`journey.${ids[i]}.out`);
const handIn = (i: number) => ({
	tag: i === 0 ? t('journey.start') : t('journey.from').replace('{n}', String(i)).replace('{name}', names[i - 1]),
	artifact: i === 0 ? t('journey.commit.in') : delivered(i - 1),
	use: t(`journey.${ids[i]}.use`),
});
const handOut = (i: number) => ({
	tag: i === total - 1 ? t('journey.end') : t('journey.to').replace('{n}', String(i + 2)).replace('{name}', names[i + 1]),
	artifact: delivered(i),
	last: i === total - 1,
});
const phases = ['dns', 'connect', 'tls', 'wait', 'download', 'render'] as const;
// Stroke icons (24 × 24) for the overview.
const icons: Record<(typeof ids)[number], string> = {
	commit: 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-9-3h6m6 0h6',
	build:
		'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm0-12v3m0 12v3M3 12h3m12 0h3M5.6 5.6l2.1 2.1m8.6 8.6 2.1 2.1m0-12.8-2.1 2.1m-8.6 8.6-2.1 2.1',
	ship: 'M4 12h13m-5-5 5 5-5 5M20 5v14',
	serve: 'M4 4h16v6H4Zm0 10h16v6H4ZM8 7h.01M8 17h.01',
	edge: 'M7 18a5 5 0 1 1 1-9.9A6 6 0 0 1 19.5 10 4 4 0 0 1 18 18Z',
	you: 'M3 4h18v12H3Zm6 16h6m-3-4v4',
};
const pagePath = `/${locale}/pipeline/`;
---

<Base title={`${t('nav.pipeline')} - João Abreu`} description={t('journey.body')}>
	<main id="main" class="page">
		<header class="page-head">
			<p class="kicker" data-reveal>{t('journey.kicker')}</p>
			<h1 data-split>{t('pipeline.heading')}</h1>
			<p data-reveal>{t('journey.body')}</p>
		</header>

		<!-- This visit's receipt: build facts now, the live ones filled in by the script. -->
		<dl class="card receipt" data-reveal style="--d: 150ms">
			<div>
				<dt>{t('journey.built')}</dt>
				<dd><time datetime={builtAt.toISOString()}>{dateTime.format(builtAt)}</time></dd>
			</div>
			{
				commit && (
					<div>
						<dt>{t('journey.commit')}</dt>
						<dd>
							<a class="mono" href={`${repoUrl}/commit/${commit.sha}`}>{commit.short}</a>
						</dd>
					</div>
				)
			}
			<div>
				<dt>{t('journey.run')}</dt>
				<dd>{runUrl ? <a href={runUrl}>#{runId} ↗</a> : t('journey.runLocal')}</dd>
			</div>
			<div>
				<dt>{t('journey.arrived')}</dt>
				<dd><strong data-receipt="total">{t('journey.measuring')}</strong></dd>
			</div>
			<div>
				<dt>{t('journey.servedBy')}</dt>
				<dd data-receipt="colo">{t('journey.measuring')}</dd>
			</div>
		</dl>

		<!-- The whole path in one picture: a packet loops through the six stops; each stop links to its stage. -->
		<section class="card overview" aria-labelledby="overview-heading" data-reveal>
			<h2 id="overview-heading">{t('journey.overview')}</h2>
			<p class="muted">{t('journey.overviewHint')}</p>
			<div class="ov">
				<span class="ov-line" aria-hidden="true"><span class="ov-strip"><i></i></span></span>
				<ol class="ov-stops">
					{
						ids.map((id, i) => (
							<li style={`--i: ${i}`}>
								<a href={`#stage-${i + 1}`}>
									<span class="ov-node">
										<svg viewBox="0 0 24 24" aria-hidden="true">
											<path d={icons[id]} />
										</svg>
									</span>
									<strong>{names[i]}</strong>
									<small>{t(`journey.${id}.short`)}</small>
								</a>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<div class="journey" id="journey" data-journey>
			<div class="rail" aria-hidden="true">
				<span class="rail-fill"></span>
				<span class="packet"></span>
			</div>

			<ol class="stations">
				<!-- 1. Commit -->
				<li class="station" id="stage-1" data-station>
					<span class="node" aria-hidden="true">01</span>
					<article class="card body">
						<p class="step">{stageLabel(1)} · {t('pipeline.commit.name')}</p>
						<h2>{t('journey.commit.title')}</h2>
						<Handoff kind="in" useLabel={t('journey.used')} {...handIn(0)} />
						<p class="muted">{t('pipeline.commit.body')}</p>
						<!-- Commits on a branch, then the merge that lands on main. -->
						<div class="viz gitviz" aria-hidden="true">
							<svg viewBox="0 0 320 92">
								<path class="g-main" d="M8 62H312" />
								<path class="g-branch" d="M64 62C92 62 92 26 120 26H200C228 26 228 62 256 62" />
								<circle class="g-old" cx="28" cy="62" r="5" />
								<circle class="g-old" cx="64" cy="62" r="5" />
								<circle class="g-c g1" cx="132" cy="26" r="5" />
								<circle class="g-c g2" cx="164" cy="26" r="5" />
								<circle class="g-c g3" cx="196" cy="26" r="5" />
								<circle class="g-halo" cx="256" cy="62" r="7" />
								<circle class="g-merge" cx="256" cy="62" r="7" />
								<text x="8" y="86">main</text>
								<text x="124" y="12">pull request</text>
								<text class="g-sha" x="236" y="86">{commit?.short ?? 'merge'}</text>
							</svg>
						</div>
						<Handoff kind="out" {...handOut(0)} />
					</article>
				</li>

				<!-- 2. GitHub Actions -->
				<li class="station" id="stage-2" data-station>
					<span class="node" aria-hidden="true">02</span>
					<article class="card body">
						<p class="step">{stageLabel(2)} · {t('pipeline.build.name')}</p>
						<h2>{t('journey.build.title')}</h2>
						<Handoff kind="in" useLabel={t('journey.used')} {...handIn(1)} />
						<p class="muted">{t('pipeline.build.body')}</p>
						<!-- Source code goes into the build and comes out as the dist/ folder. -->
						<div class="viz buildviz" aria-hidden="true">
							<div class="b-box">
								<strong>{t('journey.viz.source')}</strong>
								<span class="mono">.astro .ts .md .yaml</span>
							</div>
							<span class="b-arrow">→</span>
							<div class="b-box b-engine">
								<svg class="gear" viewBox="0 0 24 24"><path d={icons.build} /></svg>
								<strong class="mono">npm run build</strong>
								<span class="b-progress"><i></i></span>
							</div>
							<span class="b-arrow">→</span>
							<div class="b-box">
								<strong class="mono">dist/</strong>
								<span class="b-files mono"><span>en/index.html</span><span>pt/index.html</span><span>_astro/*.css</span></span>
							</div>
						</div>
						<p class="run" data-run hidden data-ok={t('journey.build.ok')} data-fail={t('journey.build.fail')} data-running={t('journey.build.running')} data-took={t('journey.build.took')}>
							<span class="run-dot" aria-hidden="true"></span>
							<span>{t('journey.build.last')}:</span>
							<a data-run-link href={`${repoUrl}/actions`}><span data-run-text></span> ↗</a>
						</p>
						{runUrl && (
							<p class="links">
								<a class="btn" href={runUrl}>{t('journey.build.thisRun')} ↗</a>
							</p>
						)}
						<Handoff kind="out" {...handOut(1)} />
					</article>
				</li>

				<!-- 3. rsync over SSH -->
				<li class="station" id="stage-3" data-station>
					<span class="node" aria-hidden="true">03</span>
					<article class="card body">
						<p class="step">{stageLabel(3)} · {t('pipeline.ship.name')}</p>
						<h2>{t('journey.ship.title')}</h2>
						<Handoff kind="in" useLabel={t('journey.used')} {...handIn(2)} />
						<p class="muted">{t('pipeline.ship.body')}</p>
						<div class="viz transfer" aria-hidden="true">
							<span class="host">{t('journey.ship.runner')}</span>
							<span class="wire">
								<span class="file"><i></i></span>
								<span class="file"><i></i></span>
								<span class="file"><i></i></span>
								<span class="file"><i></i></span>
								<span class="lock">SSH</span>
							</span>
							<span class="host">{t('journey.ship.server')}</span>
						</div>
						<Handoff kind="out" {...handOut(2)} />
					</article>
				</li>

				<!-- 4. nginx -->
				<li class="station" id="stage-4" data-station>
					<span class="node" aria-hidden="true">04</span>
					<article class="card body">
						<p class="step">{stageLabel(4)} · {t('pipeline.serve.name')}</p>
						<h2>{t('journey.serve.title')}</h2>
						<Handoff kind="in" useLabel={t('journey.used')} {...handIn(3)} />
						<p class="muted">{t('pipeline.serve.body')}</p>
						<!-- A request goes in, nginx picks the file, the response comes back. -->
						<div class="viz transfer httpviz" aria-hidden="true">
							<span class="host">Cloudflare</span>
							<span class="lanes">
								<span class="wire"><span class="file req"><b class="msg mono">GET {pagePath}</b></span></span>
								<span class="wire"><span class="file res"><b class="msg ok mono">200 OK · text/html</b></span></span>
							</span>
							<span class="host">nginx<small class="mono">/var/www/portfolio</small></span>
						</div>
						<p class="note">{t('journey.serve.headers')}</p>
						<pre class="term headers" data-headers data-none={t('journey.serve.none')}><code><span class="dim">{t('journey.measuring')}</span></code></pre>
						<Handoff kind="out" {...handOut(3)} />
					</article>
				</li>

				<!-- 5. Cloudflare -->
				<li class="station" id="stage-5" data-station>
					<span class="node" aria-hidden="true">05</span>
					<article class="card body">
						<p class="step">{stageLabel(5)} · {t('pipeline.edge.name')}</p>
						<h2>{t('journey.edge.title')}</h2>
						<Handoff kind="in" useLabel={t('journey.used')} {...handIn(4)} />
						<p class="muted">{t('pipeline.edge.body')}</p>
						<!-- One fetch from the server, a cached copy at the edge, many fast deliveries to you. -->
						<div class="viz transfer edgeviz" aria-hidden="true">
							<span class="host">{t('journey.viz.server')}</span>
							<span class="wire"><span class="file once"><i></i></span></span>
							<span class="host cloud">Cloudflare<small>{t('journey.viz.cache')}</small></span>
							<span class="wire">
								<span class="file"><i></i></span>
								<span class="file"><i></i></span>
								<span class="file"><i></i></span>
								<span class="lock">HTTPS</span>
							</span>
							<span class="host">{t('pipeline.you.name')}</span>
						</div>
						<dl class="tiles" data-edge>
							<div><dt>{t('journey.edge.colo')}</dt><dd data-edge-value="colo">—</dd></div>
							<div><dt>{t('journey.edge.protocol')}</dt><dd data-edge-value="http">—</dd></div>
							<div><dt>{t('journey.edge.tls')}</dt><dd data-edge-value="tls">—</dd></div>
							<div><dt>{t('journey.edge.cache')}</dt><dd data-edge-value="cache">—</dd></div>
						</dl>
						<p class="note muted" data-edge-missing hidden>{t('journey.onlyLive')}</p>
						<Handoff kind="out" {...handOut(4)} />
					</article>
				</li>

				<!-- 6. You -->
				<li class="station" id="stage-6" data-station>
					<span class="node" aria-hidden="true">06</span>
					<article class="card body">
						<p class="step">{stageLabel(6)} · {t('pipeline.you.name')}</p>
						<h2>{t('journey.you.title')}</h2>
						<Handoff kind="in" useLabel={t('journey.used')} {...handIn(5)} />
						<p class="muted">{t('pipeline.you.body')}</p>
						<!-- The browser builds the page: bare HTML, then CSS, then the live data from JavaScript. -->
						<div class="viz browser" aria-hidden="true">
							<div class="br-bar"><i></i><i></i><i></i><span class="mono">joaoabreu.dev{pagePath}</span></div>
							<div class="br-page">
								<div class="br-layer br-html">
									<span class="sk sk-title"></span><span class="sk"></span><span class="sk short"></span>
									<span class="sk-row"><span class="sk-card"></span><span class="sk-card"></span><span class="sk-card"></span></span>
								</div>
								<div class="br-layer br-css">
									<span class="sk sk-title"></span><span class="sk"></span><span class="sk short"></span>
									<span class="sk-row"><span class="sk-card"></span><span class="sk-card"></span><span class="sk-card"></span></span>
								</div>
								<span class="br-live"><i></i>live</span>
							</div>
							<ol class="br-steps"><li>HTML</li><li>CSS</li><li>JavaScript</li></ol>
						</div>
						<p class="note">{t('journey.you.note')}</p>
						<ol class="waterfall" data-waterfall data-cached={t('journey.you.cached')}>
							{
								phases.map((p) => (
									<li data-phase={p}>
										<span class="phase">{t(`journey.you.${p}`)}</span>
										<span class="lane">
											<span class="bar" />
										</span>
										<span class="ms mono">—</span>
									</li>
								))
							}
						</ol>
						<dl class="tiles small">
							<div><dt>{t('journey.you.total')}</dt><dd data-you="total">—</dd></div>
							<div><dt>{t('journey.you.bytes')}</dt><dd data-you="bytes">—</dd></div>
							<div><dt>{t('journey.edge.protocol')}</dt><dd data-you="protocol">—</dd></div>
						</dl>
						<Handoff kind="out" {...handOut(5)} />
					</article>
				</li>
			</ol>
		</div>

		<footer class="outro" data-reveal>
			<p>{t('pipeline.when')}</p>
			<p class="links">
				<a class="btn btn-primary" href="#journey">↑ {t('journey.replay')}</a>
				<a class="btn" href={workflowUrl}>{t('pipeline.workflow')} ↗</a>
				<a class="btn" href={serverUrl}>{t('pipeline.server')} ↗</a>
			</p>
		</footer>
	</main>
</Base>

<script>
	import '../../scripts/journey';
</script>

<style>
	.kicker {
		margin: 0 0 0.75rem;
		color: var(--brand);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.mono,
	.term {
		font-family: var(--font-mono);
	}

	/* ---- Receipt ---- */
	.receipt {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
		gap: 1rem 1.5rem;
		margin: 0 0 4rem;
	}

	.receipt dt,
	.tiles dt {
		color: var(--fg-muted);
		font-size: 0.75rem;
	}

	.receipt dd,
	.tiles dd {
		margin: 0.2rem 0 0;
		font-weight: 600;
		overflow-wrap: anywhere;
	}

	.receipt strong {
		color: var(--brand);
		font-size: 1.15rem;
	}

	/* ---- Journey: a rail with a packet that follows the scroll, and six stations ---- */
	.journey {
		--node: 2.75rem;
		position: relative;
		padding-bottom: 2rem;
	}

	.rail {
		position: absolute;
		top: calc(var(--node) / 2);
		bottom: 4rem;
		left: calc(var(--node) / 2 - 1px);
		width: 2px;
		background: var(--line);
	}

	.rail-fill {
		position: absolute;
		inset: 0;
		background: linear-gradient(var(--brand-2), var(--accent), #6366f1);
		transform-origin: top;
	}

	.packet {
		display: none;
	}

	.stations {
		display: grid;
		gap: clamp(3rem, 12vh, 7rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.station {
		display: grid;
		grid-template-columns: var(--node) minmax(0, 1fr);
		gap: clamp(0.85rem, 3vw, 2rem);
		align-items: start;
	}

	.node {
		position: relative;
		z-index: 1;
		display: grid;
		place-items: center;
		width: var(--node);
		height: var(--node);
		background: var(--accent);
		border-radius: 50%;
		color: var(--on-accent);
		font-size: 0.8rem;
		font-weight: 800;
		box-shadow: 0 0 0 6px var(--bg);
	}

	/* A soft halo behind the lit node; only its opacity changes. */
	.node::before {
		content: '';
		position: absolute;
		inset: -10px;
		z-index: -1;
		border-radius: 50%;
		background: radial-gradient(color-mix(in srgb, var(--brand) 55%, transparent), transparent 70%);
		opacity: 0;
	}

	.body {
		padding: clamp(1.25rem, 3vw, 2rem);
	}

	.step {
		margin: 0 0 0.5rem;
		color: var(--brand);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	h2 {
		margin: 0 0 0.6rem;
		font-size: clamp(1.4rem, 3.2vw, 2rem);
		letter-spacing: -0.03em;
		line-height: 1.15;
	}

	.body > p.muted {
		margin: 0;
		max-width: 60ch;
	}

	.note {
		margin: 1.5rem 0 0.6rem;
		font-size: 0.85rem;
		font-weight: 600;
	}

	/* Terminal blocks */
	.term {
		margin: 1.25rem 0 0;
		padding: 1rem 1.15rem;
		overflow-x: auto;
		background: color-mix(in srgb, var(--bg) 70%, #000);
		border: 1px solid var(--line);
		border-radius: 0.75rem;
		color: #e5e7eb;
		font-size: 0.8rem;
		line-height: 1.7;
	}

	.note + .term {
		margin-top: 0;
	}

	.term .hl {
		color: #7dd3fc;
	}

	.term .dim {
		color: #9ca3af;
	}

	.run {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin: 1rem 0 0;
		font-size: 0.85rem;
	}

	.run[hidden] {
		display: none;
	}

	.run-dot {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 50%;
		background: var(--fg-muted);
	}

	.run[data-state='ok'] .run-dot {
		background: #22c55e;
	}

	.run[data-state='fail'] .run-dot {
		background: #ef4444;
	}

	.run[data-state='running'] .run-dot {
		background: #f59e0b;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 1.25rem 0 0;
	}

	/* rsync: files crossing from the runner to the server over SSH */
	.transfer {
		display: grid;
		grid-template-columns: auto minmax(3rem, 1fr) auto;
		align-items: center;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}

	.host {
		padding: 0.6rem 0.8rem;
		background: var(--surface-2);
		border: 1px solid var(--line);
		border-radius: 0.6rem;
		font-size: 0.8rem;
		font-weight: 600;
		text-align: center;
	}

	.wire {
		position: relative;
		height: 1.75rem;
		overflow: hidden;
		background: linear-gradient(var(--line), var(--line)) center / 100% 2px no-repeat;
	}

	/* Each file is a full-width strip moved from -100% to 0, carrying its square to the right end. */
	.file {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		transform: translateX(-100%);
	}

	.file i {
		width: 0.7rem;
		height: 0.85rem;
		background: var(--brand);
		border-radius: 2px;
		box-shadow: 0 0 10px var(--brand);
	}

	.lock {
		position: absolute;
		top: 50%;
		left: 50%;
		padding: 0 0.4rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--fg-muted);
		font-size: 0.65rem;
		font-weight: 700;
		transform: translate(-50%, -50%);
	}

	.headers {
		white-space: pre;
	}

	/* Cloudflare and visit tiles */
	.tiles {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 8.5rem), 1fr));
		gap: 0.75rem;
		margin: 1.5rem 0 0;
	}

	.tiles div {
		padding: 0.9rem 1rem;
		background: var(--surface-2);
		border: 1px solid var(--line);
		border-radius: 0.75rem;
	}

	.tiles dd {
		font-size: 1.15rem;
	}

	.tiles.small dd {
		font-size: 1rem;
	}

	/* Waterfall of this visit */
	.waterfall {
		display: grid;
		gap: 0.55rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.8rem;
	}

	.waterfall li {
		display: grid;
		grid-template-columns: minmax(6.5rem, 9rem) minmax(0, 1fr) 4.5rem;
		align-items: center;
		gap: 0.75rem;
	}

	.lane {
		position: relative;
		height: 0.7rem;
		background: var(--surface-2);
		border-radius: 999px;
	}

	.bar {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		width: 0;
		min-width: 3px;
		background: linear-gradient(90deg, var(--brand-2), var(--accent));
		border-radius: 999px;
		transform-origin: left;
	}

	.ms {
		color: var(--fg-muted);
		text-align: right;
	}

	.outro {
		margin: 4rem 0 2rem;
		padding-top: 2rem;
		border-top: 1px solid var(--line);
		color: var(--fg-muted);
	}

	@media (max-width: 40rem) {
		.journey {
			--node: 2.1rem;
		}

		.transfer {
			grid-template-columns: 1fr;
			text-align: center;
		}

		.wire {
			height: 1.5rem;
		}

		.waterfall li {
			grid-template-columns: minmax(0, 1fr) 4rem;
		}

		.waterfall .lane {
			grid-column: 1 / -1;
			grid-row: 2;
		}
	}

	/*
	 * Motion (only with .fx, which the head script sets when motion is allowed). The script moves
	 * the packet and fill with the scroll and marks reached stations .on; everything is transform
	 * and opacity. Without it every station is simply shown, fully lit.
	 */
	:global(.fx) .journey[data-ready] .rail-fill {
		transform: scaleY(var(--progress, 0));
	}

	:global(.fx) .journey[data-ready] .packet {
		position: absolute;
		top: 0;
		left: 50%;
		display: block;
		width: 14px;
		height: 14px;
		margin: -7px 0 0 -7px;
		background: #fff;
		border-radius: 50%;
		box-shadow:
			0 0 0 4px color-mix(in srgb, var(--brand) 45%, transparent),
			0 0 24px 6px var(--brand);
		transform: translateY(var(--packet, 0px));
	}

	:global(.fx) .journey[data-ready] .station .node {
		background: var(--surface-2);
		color: var(--fg-muted);
	}

	:global(.fx) .journey[data-ready] .station .body {
		transform: translateY(1.5rem) scale(0.98);
		transition:
			transform 0.6s var(--ease);
	}

	:global(.fx) .journey[data-ready] .station.on .node {
		background: var(--accent);
		color: var(--on-accent);
	}

	:global(.fx) .journey[data-ready] .station.on .node::before {
		opacity: 1;
		transition: opacity 0.6s;
	}

	:global(.fx) .journey[data-ready] .station.on .body {
		transform: none;
	}

	:global(.fx) .journey[data-ready] .station.on .file {
		animation: ship 2.4s linear infinite;
	}

	:global(.fx) .journey[data-ready] .station.on .file:nth-child(2) { animation-delay: 0.6s; }
	:global(.fx) .journey[data-ready] .station.on .file:nth-child(3) { animation-delay: 1.2s; }
	:global(.fx) .journey[data-ready] .station.on .file:nth-child(4) { animation-delay: 1.8s; }

	@keyframes ship {
		0% {
			opacity: 0;
			transform: translateX(-100%);
		}
		10%,
		85% {
			opacity: 1;
		}
		100% {
			opacity: 0;
			transform: translateX(0);
		}
	}

	/* The waterfall bars grow from the left once the last station is reached. */
	:global(.fx) .journey[data-ready] .bar {
		transform: scaleX(0);
	}

	:global(.fx) .journey[data-ready] .station.on .bar {
		transform: scaleX(1);
		transition: transform 0.9s var(--ease);
	}

	:global(.fx) .journey[data-ready] .station.on .waterfall li:nth-child(2) .bar { transition-delay: 0.15s; }
	:global(.fx) .journey[data-ready] .station.on .waterfall li:nth-child(3) .bar { transition-delay: 0.3s; }
	:global(.fx) .journey[data-ready] .station.on .waterfall li:nth-child(4) .bar { transition-delay: 0.45s; }
	:global(.fx) .journey[data-ready] .station.on .waterfall li:nth-child(5) .bar { transition-delay: 0.6s; }
	:global(.fx) .journey[data-ready] .station.on .waterfall li:nth-child(6) .bar { transition-delay: 0.75s; }

	.station {
		scroll-margin-top: 6rem;
	}

	/* ---- Overview: the six stops in one row (one column on phones), a packet looping through ---- */
	.overview {
		margin: 0 0 4.5rem;
		padding: clamp(1.5rem, 4vw, 2.25rem);
	}

	.overview h2 {
		margin-bottom: 0.35rem;
	}

	.overview > .muted {
		margin: 0 0 2rem;
	}

	.ov {
		--ov-node: 3rem;
		position: relative;
	}

	.ov-line {
		position: absolute;
		top: calc(var(--ov-node) / 2 - 1px);
		left: calc(100% / 12);
		right: calc(100% / 12);
		height: 2px;
		background: linear-gradient(90deg, var(--brand-2), var(--accent), #6366f1);
		opacity: 0.6;
	}

	.ov-strip {
		position: absolute;
		inset: 0;
		display: none;
		align-items: center;
		justify-content: flex-end;
	}

	.ov-strip i {
		width: 12px;
		height: 12px;
		margin-right: -6px;
		background: #fff;
		border-radius: 50%;
		box-shadow:
			0 0 0 4px color-mix(in srgb, var(--brand) 45%, transparent),
			0 0 22px 6px var(--brand);
	}

	.ov-stops {
		position: relative;
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.ov-stops a {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.35rem;
		padding-inline: 0.25rem;
		color: var(--fg);
		text-align: center;
		text-decoration: none;
	}

	.ov-node {
		position: relative;
		display: grid;
		place-items: center;
		width: var(--ov-node);
		height: var(--ov-node);
		margin-bottom: 0.4rem;
		background: var(--accent);
		border-radius: 50%;
		box-shadow: 0 0 0 6px var(--surface);
	}

	.ov-node::after {
		content: '';
		position: absolute;
		inset: -6px;
		border-radius: 50%;
		background: radial-gradient(color-mix(in srgb, var(--brand) 70%, transparent), transparent 70%);
		opacity: 0;
	}

	.ov-node svg {
		position: relative;
		z-index: 1;
		width: 1.3rem;
		height: 1.3rem;
		fill: none;
		stroke: #fff;
		stroke-width: 1.75;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.ov-stops strong {
		font-size: 0.85rem;
		line-height: 1.25;
	}

	.ov-stops small {
		color: var(--fg-muted);
		font-size: 0.72rem;
		line-height: 1.3;
	}

	.ov-stops a:hover strong {
		color: var(--brand);
	}

	/* ---- Stage visuals: a panel per stage ---- */
	.viz {
		margin-top: 1.5rem;
		padding: 1.25rem;
		background: color-mix(in srgb, var(--surface-2) 70%, transparent);
		border: 1px solid var(--line);
		border-radius: 0.85rem;
	}

	/* 1. Git graph */
	.gitviz svg {
		display: block;
		width: 100%;
		max-width: 34rem;
		height: auto;
		margin: 0 auto;
		overflow: visible;
	}

	.gitviz path {
		fill: none;
		stroke-width: 2.5;
		stroke-linecap: round;
	}

	.g-main {
		stroke: var(--fg-muted);
	}

	.g-branch {
		stroke: var(--brand-2);
		stroke-dasharray: 5 5;
	}

	.g-old {
		fill: var(--fg-muted);
	}

	.g-c {
		fill: var(--brand-2);
	}

	.g-merge {
		fill: var(--accent);
		stroke: #fff;
		stroke-width: 2;
	}

	.g-halo {
		fill: var(--brand);
		opacity: 0;
	}

	.gitviz circle {
		transform-box: fill-box;
		transform-origin: center;
	}

	.gitviz text {
		fill: var(--fg-muted);
		font-family: var(--font-sans);
		font-size: 10px;
		font-weight: 600;
	}

	.gitviz .g-sha {
		fill: var(--brand);
		font-family: var(--font-mono);
	}

	/* 2. Build */
	.buildviz {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		gap: 0.75rem;
	}

	.b-box {
		display: grid;
		gap: 0.35rem;
		justify-items: center;
		padding: 0.85rem 0.75rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 0.65rem;
		text-align: center;
	}

	.b-box strong {
		font-size: 0.8rem;
	}

	.b-box > .mono,
	.b-files {
		color: var(--fg-muted);
		font-size: 0.68rem;
	}

	.b-files {
		display: grid;
		gap: 0.15rem;
	}

	.b-engine {
		border-color: color-mix(in srgb, var(--brand) 60%, var(--line));
	}

	.gear {
		width: 1.6rem;
		height: 1.6rem;
		fill: none;
		stroke: var(--brand);
		stroke-width: 1.75;
		stroke-linecap: round;
	}

	.b-progress {
		display: block;
		width: 100%;
		height: 4px;
		overflow: hidden;
		background: var(--surface-2);
		border-radius: 999px;
	}

	.b-progress i {
		display: block;
		height: 100%;
		background: linear-gradient(90deg, var(--brand-2), var(--accent));
		transform-origin: left;
	}

	.b-arrow {
		color: var(--brand);
		font-weight: 700;
	}

	/* 4. HTTP request and response */
	.httpviz .lanes {
		display: grid;
		gap: 0.4rem;
		min-width: 0;
	}

	.httpviz .wire {
		height: 1.6rem;
	}

	.httpviz .res {
		justify-content: flex-start;
	}

	.msg {
		padding: 0.15rem 0.45rem;
		background: var(--surface);
		border: 1px solid color-mix(in srgb, var(--brand) 60%, var(--line));
		border-radius: 0.4rem;
		color: var(--brand);
		font-size: 0.66rem;
		font-weight: 600;
		white-space: nowrap;
	}

	.msg.ok {
		border-color: color-mix(in srgb, #22c55e 60%, var(--line));
		color: #4ade80;
	}

	.host small {
		display: block;
		margin-top: 0.15rem;
		color: var(--fg-muted);
		font-size: 0.65rem;
		font-weight: 500;
	}

	/* 5. Cloudflare */
	.edgeviz {
		grid-template-columns: auto minmax(2rem, 1fr) auto minmax(2rem, 1fr) auto;
	}

	.cloud {
		border-color: color-mix(in srgb, #f38020 60%, var(--line));
	}

	/* 6. Browser */
	.browser {
		padding: 0;
		overflow: hidden;
	}

	.br-bar {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.55rem 0.8rem;
		background: var(--surface);
		border-bottom: 1px solid var(--line);
	}

	.br-bar i {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 50%;
		background: var(--line);
	}

	.br-bar span {
		margin-left: 0.5rem;
		overflow: hidden;
		color: var(--fg-muted);
		font-size: 0.68rem;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.br-page {
		position: relative;
		height: 9.5rem;
	}

	.br-layer {
		position: absolute;
		inset: 0;
		display: grid;
		align-content: start;
		gap: 0.55rem;
		padding: 1rem 1.1rem;
	}

	.sk {
		display: block;
		width: 70%;
		height: 0.5rem;
		border-radius: 999px;
	}

	.sk-title {
		width: 45%;
		height: 0.9rem;
	}

	.sk.short {
		width: 50%;
	}

	.sk-row {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.5rem;
		margin-top: 0.4rem;
	}

	.sk-card {
		height: 2.6rem;
		border-radius: 0.4rem;
	}

	/* Bare HTML: outlines only. */
	.br-html .sk,
	.br-html .sk-card {
		border: 1px dashed var(--fg-muted);
		opacity: 0.6;
	}

	/* With CSS: colors and surfaces. */
	.br-css {
		background: var(--bg);
	}

	.br-css .sk {
		background: color-mix(in srgb, var(--fg) 25%, transparent);
	}

	.br-css .sk-title {
		background: linear-gradient(90deg, var(--brand-2), var(--accent), #6366f1);
	}

	.br-css .sk-card {
		background: var(--surface-2);
		border: 1px solid var(--line);
	}

	.br-live {
		position: absolute;
		right: 1rem;
		bottom: 0.85rem;
		display: flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.15rem 0.5rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 999px;
		color: #4ade80;
		font-size: 0.68rem;
		font-weight: 700;
	}

	.br-live i {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: #22c55e;
	}

	.br-steps {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
		margin: 0;
		padding: 0.7rem;
		list-style: none;
		border-top: 1px solid var(--line);
		font-size: 0.72rem;
		font-weight: 700;
	}

	.br-steps li {
		padding: 0.15rem 0.6rem;
		background: color-mix(in srgb, var(--accent) 18%, transparent);
		border-radius: 999px;
		color: var(--brand);
	}

	@media (max-width: 40rem) {
		.ov-stops {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.ov-stops a {
			display: grid;
			grid-template-columns: var(--ov-node) minmax(0, 1fr);
			column-gap: 0.9rem;
			row-gap: 0;
			align-items: center;
			text-align: left;
		}

		.ov-node {
			grid-row: span 2;
			margin: 0;
		}

		.ov-line {
			top: calc(var(--ov-node) / 2);
			bottom: calc(var(--ov-node) / 2);
			left: calc(var(--ov-node) / 2 - 1px);
			right: auto;
			width: 2px;
			height: auto;
			background: linear-gradient(var(--brand-2), var(--accent), #6366f1);
		}

		.ov-strip {
			flex-direction: column;
		}

		.ov-strip i {
			margin: 0 0 -6px;
		}

		.buildviz,
		.edgeviz {
			grid-template-columns: 1fr;
		}

		.b-arrow {
			justify-self: center;
			transform: rotate(90deg);
		}
	}

	/* ---- Motion for the visuals (only with .fx; the static state above is the finished picture) ---- */
	:global(.fx) .ov-strip {
		display: flex;
		animation: ov-x 6s linear infinite;
	}

	:global(.fx) .ov-node {
		animation: ov-bump 6s ease-out infinite;
		animation-delay: calc(var(--i) * 1.02s);
	}

	:global(.fx) .ov-node::after {
		animation: ov-halo 6s ease-out infinite;
		animation-delay: calc(var(--i) * 1.02s);
	}

	@media (max-width: 40rem) {
		:global(.fx) .ov-strip {
			animation-name: ov-y;
		}
	}

	@keyframes ov-x {
		0% {
			opacity: 1;
			transform: translateX(-100%);
		}
		85% {
			opacity: 1;
			transform: translateX(0);
		}
		95%,
		100% {
			opacity: 0;
			transform: translateX(0);
		}
	}

	@keyframes ov-y {
		0% {
			opacity: 1;
			transform: translateY(-100%);
		}
		85% {
			opacity: 1;
			transform: translateY(0);
		}
		95%,
		100% {
			opacity: 0;
			transform: translateY(0);
		}
	}

	@keyframes ov-bump {
		0% {
			transform: scale(1.18);
		}
		12%,
		100% {
			transform: scale(1);
		}
	}

	@keyframes ov-halo {
		0% {
			opacity: 1;
			transform: scale(1);
		}
		25%,
		100% {
			opacity: 0;
			transform: scale(1.9);
		}
	}

	/* 1. Commits pop onto the branch, then the merge lands on main with a ring. */
	:global(.fx) .journey[data-ready] .station.on .g-c {
		animation: g-pop 4.5s ease-out infinite backwards;
	}

	:global(.fx) .journey[data-ready] .station.on .g1 { animation-delay: 0.2s; }
	:global(.fx) .journey[data-ready] .station.on .g2 { animation-delay: 0.7s; }
	:global(.fx) .journey[data-ready] .station.on .g3 { animation-delay: 1.2s; }

	:global(.fx) .journey[data-ready] .station.on .g-merge {
		animation: g-pop 4.5s ease-out 2s infinite backwards;
	}

	:global(.fx) .journey[data-ready] .station.on .g-halo {
		animation: g-halo 4.5s ease-out 2s infinite backwards;
	}

	@keyframes g-pop {
		0%,
		4% {
			opacity: 0;
			transform: scale(0);
		}
		12%,
		88% {
			opacity: 1;
			transform: scale(1);
		}
		100% {
			opacity: 0;
			transform: scale(1);
		}
	}

	@keyframes g-halo {
		0%,
		8% {
			opacity: 0;
			transform: scale(1);
		}
		14% {
			opacity: 0.8;
		}
		45%,
		100% {
			opacity: 0;
			transform: scale(3.2);
		}
	}

	/* 2. The gear turns, the bar fills, the built files appear. */
	:global(.fx) .journey[data-ready] .station.on .gear {
		animation: spin 3s linear infinite;
	}

	:global(.fx) .journey[data-ready] .station.on .b-progress i {
		animation: fill 3s ease-in-out infinite;
	}

	:global(.fx) .journey[data-ready] .station.on .b-files span {
		animation: appear 3s ease-out infinite backwards;
	}

	:global(.fx) .journey[data-ready] .station.on .b-files span:nth-child(2) { animation-delay: 0.15s; }
	:global(.fx) .journey[data-ready] .station.on .b-files span:nth-child(3) { animation-delay: 0.3s; }

	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}

	@keyframes fill {
		0% {
			transform: scaleX(0);
		}
		65%,
		100% {
			transform: scaleX(1);
		}
	}

	@keyframes appear {
		0%,
		62% {
			opacity: 0;
			transform: translateY(4px);
		}
		72%,
		100% {
			opacity: 1;
			transform: none;
		}
	}

	/* 4. Request out, response back. */
	:global(.fx) .journey[data-ready] .station.on .req {
		animation: req 4s ease-in-out infinite;
	}

