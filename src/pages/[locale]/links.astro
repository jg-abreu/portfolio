---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../../layouts/Base.astro';
import ContactIcon from '../../components/ContactIcon.astro';
import VisitCounter from '../../components/VisitCounter.astro';
import { recommendationUi } from '../../i18n/recommendations';
import { locales, useTranslations, type Locale } from '../../i18n/ui';
import { getBlogArticles } from '../../lib/blog-data';
import { getContacts, getResumePath, obfuscatedMailto } from '../../lib/content';

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
const contacts = await getContacts();
const email = contacts.find((c) => c.kind === 'email');
const profiles = contacts.filter((c) => c.kind !== 'email');
const resumePath = getResumePath(locale);
const latest = getBlogArticles()[0];

const links = [
	{
		href: getRelativeLocaleUrl(locale),
		title: t('links.portfolio'),
		body: t('links.portfolioBody'),
		icon: 'M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1Z',
	},
	{
		href: getRelativeLocaleUrl(locale, 'projects/'),
		title: t('nav.projects'),
		body: t('links.projectsBody'),
		icon: 'M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z',
	},
	{
		href: resumePath ?? getRelativeLocaleUrl(locale, 'resume/'),
		title: t('nav.resume'),
		body: resumePath ? t('links.resumeBody') : t('resume.body'),
		icon: 'M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Zm0 0v6h6M8 13h8m-8 4h5',
	},
	...(latest
		? [
				{
					href: getRelativeLocaleUrl(locale, `blog/${latest.slug}/`),
					title: t('links.latest'),
					body: latest.title,
					icon: 'M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16Zm9.5-13.5 4 4',
				},
			]
		: []),
	{
		href: getRelativeLocaleUrl(locale, 'recommendations/'),
		title: recommendationUi[locale].title,
		body: t('links.recommendationsBody'),
		icon: 'M6 3h12v18l-6-4-6 4Z',
	},
];
---

<Base title={`${t('links.title')} - João Abreu`} description={t('links.description')} bare>
	<main id="main" class="links-page">
		<header class="intro">
			<span class="mark" aria-hidden="true">JA</span>
			<h1>João Abreu</h1>
			<p class="role">{t('home.role')}</p>
			<p class="badges">
				<span class="badge"><span class="dot" aria-hidden="true"></span>{t('home.status')}</span>
				<span class="badge">{t('home.location')}</span>
				<VisitCounter locale={locale} variant="badge" />
			</p>
		</header>

		<ul class="links">
			{
				links.map((l) => (
					<li class="link">
						<span class="icon" aria-hidden="true">
							<svg viewBox="0 0 24 24">
								<path d={l.icon} />
							</svg>
						</span>
						<span class="text">
							<a class="stretch" href={l.href}>
								{l.title}
							</a>
							<span class="body">{l.body}</span>
						</span>
						<span class="arrow" aria-hidden="true">
							→
						</span>
					</li>
				))
			}
			{
				email && (
					<li class="link">
						<span class="icon" aria-hidden="true">
							<ContactIcon name="email" />
						</span>
						<span class="text">
							<span class="title">{t('links.email')}</span>
							<Fragment set:html={obfuscatedMailto(email.address, 'body stretch')} />
						</span>
						<span class="arrow" aria-hidden="true">
							→
						</span>
					</li>
				)
			}
		</ul>

		<nav class="profiles" aria-label={t('links.profiles')}>
			<ul>
				{
					profiles.map((c) => (
						<li>
							<a href={c.url} title={c.label} aria-label={c.label}>
								<ContactIcon name={c.kind} />
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</main>
</Base>

<style>
	.links-page {
		display: grid;
		gap: 2rem;
		max-width: 34rem;
		margin: 0 auto;
		padding: clamp(2rem, 8vw, 4rem) var(--gutter) 3rem;
		overflow-wrap: anywhere;
	}

	.intro {
		display: grid;
		justify-items: center;
		gap: 0.5rem;
		text-align: center;
	}

	.mark {
		display: grid;
		place-items: center;
		width: 4.5rem;
		height: 4.5rem;
		margin-bottom: 0.5rem;
		background: linear-gradient(135deg, var(--brand-2), var(--accent) 55%, #6366f1);
		border-radius: 1.25rem;
		color: var(--on-accent);
		font-size: 1.6rem;
		font-weight: 800;
		letter-spacing: -0.04em;
	}

	h1 {
		margin: 0;
		font-size: clamp(1.75rem, 6vw, 2.25rem);
		font-weight: 700;
		letter-spacing: -0.035em;
		line-height: 1.1;
	}

	.role {
		margin: 0;
		color: var(--fg-muted);
	}

	.badges {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		margin: 0.5rem 0 0;
	}

	.links {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.link {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.9rem;
		padding: 0.85rem 1rem;
		background: color-mix(in srgb, var(--surface) 92%, transparent);
		border: 1px solid var(--line);
		border-radius: var(--radius);
	}

	.link:hover,
	.link:focus-within {
		background: var(--surface-2);
		border-color: var(--fg-muted);
	}

	.icon {
		display: grid;
		flex-shrink: 0;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		background: var(--surface-2);
		border: 1px solid var(--line);
		border-radius: 0.7rem;
		color: var(--brand);
	}

	.icon svg {
		width: 1.15rem;
		height: 1.15rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.75;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.text {
		display: grid;
		flex: 1;
		min-width: 0;
	}

	.text .stretch,
	.title {
		color: var(--fg);
		font-weight: 600;
		text-decoration: none;
	}

	.text :global(.body),
	.body {
		color: var(--fg-muted);
		font-size: 0.85rem;
		text-decoration: none;
	}

	.text :global(.stretch)::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}

	.text :global(.stretch):focus-visible {
		outline: none;
	}

	.link:has(:focus-visible) {
		outline: 2px solid var(--brand);
		outline-offset: 3px;
	}

	.arrow {
		flex-shrink: 0;
		color: var(--fg-muted);
	}

	.link:hover .arrow {
		color: var(--fg);
	}

	.profiles ul {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.6rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.profiles a {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		background: color-mix(in srgb, var(--surface) 92%, transparent);
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--fg-muted);
	}

	.profiles a:hover {
		background: var(--surface-2);
		border-color: var(--fg-muted);
		color: var(--fg);
	}

	.profiles :global(svg) {
		width: 1.2rem;
		height: 1.2rem;
	}

	@media (prefers-reduced-motion: no-preference) {
		.link,
		.profiles a {
			transition:
				transform 0.25s var(--ease),
				background-color 0.2s,
				border-color 0.2s;
		}

		.link:hover,
		.profiles a:hover {
			transform: translateY(-2px);
		}

		.link .arrow {
			transition: transform 0.25s var(--ease);
		}

		.link:hover .arrow {
			transform: translateX(3px);
		}
	}
</style>
