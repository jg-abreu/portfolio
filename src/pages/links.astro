---
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n';
import { defaultLocale } from '../i18n/ui';

const target = getRelativeLocaleUrl(defaultLocale, 'links/');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>João Abreu</title>
		<meta name="robots" content="noindex" />
		<link rel="canonical" href={getAbsoluteLocaleUrl(defaultLocale, 'links/')} />
		<meta http-equiv="refresh" content={`0;url=${target}`} />
	</head>
	<body>
		<a href={target}>joaoabreu.dev{target}</a>
	</body>
</html>
